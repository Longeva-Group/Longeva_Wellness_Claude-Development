line-end":0},"blocks":{}}},"block_order":["image_4gFG4E","text_nJB6Mc"]},"group_KBDjY3":{"type":"group","name":"t:names.column","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"flex-start","gap":8,"width":"fill","custom_width":100,"width_mobile":"fill","custom_width_mobile":100,"height":"fit","custom_height":100,"inherit_color_scheme":true,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","link":"","open_in_new_tab":false,"placeholder":"","padding-block-start":10,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"text_rJbNgr":{"type":"text","name":"t:names.heading","settings":{"text":"<h2>A Note From Anthony<\/h2>","width":"100%","max_width":"normal","alignment":"center","type_preset":"h4","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_xMfHG9":{"type":"text","name":"t:names.description","settings":{"text":"<p><em>\"The aesthetics and private health sector has grown rapidly - but growth and quality are not the same.<\/em><\/p><p><em>Having built this business from within the aesthetics industry, I have seen first-hand how quickly the space has expanded; often without the clinical rigour, regulatory discipline, or patient-first decision making that should underpin any healthcare service.<\/em><\/p><p><em>Longeva was created to set a different standard.<\/em><\/p><p><em>We are a highly regulated, pharmacist-led organisation, operating under both GPhC registration and WDA licensing - frameworks that ensure accountability, traceability, and clinical governance at every level of the business.<\/em><\/p><p><em>This foundation matters. It allows us to deliver aesthetic treatments, healthcare services, and preventative care within a structure that prioritises safety, evidence, and long-term patient outcomes.<\/em><\/p><p><em>We are not driven by trends or short-term demand. Every decision is made through a clinical lens - with a clear focus on what is appropriate, safe, and effective for the patient.<\/em><\/p><p><em>Longeva is being built with a longer-term view. The name reflects that intent - a commitment to care that compounds over time, supporting health, confidence, and longevity in a way that is considered, not reactive.<\/em><\/p><p><em>That standard is deliberate. It is not the easiest way to operate - but it is the only way we believe a clinic should be run.\"<\/em><\/p><p><strong>Anthony Higgins<\/strong><br\/><em>Chairman, Longeva Group<\/em><\/p>","width":"100%","max_width":"normal","alignment":"center","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["text_rJbNgr","text_xMfHG9"]}},"block_order":["group_AadgQH","group_KBDjY3"],"name":"t:names.multicolumn","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"flex-start","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":16,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":48,"padding-block-end":48}}},"order":["main","slideshow_rrUNH4","section_EqqWdw","section_fU6YV4","section_8WX86A","section_xxr3wW","section_irJPtr"]}