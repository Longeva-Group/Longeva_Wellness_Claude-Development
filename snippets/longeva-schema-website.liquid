{%- comment -%}
  Sitewide WebSite schema with SearchAction.

  Rendered from layout/theme.liquid so it ships on every page. Gives
  Google the potential sitelinks search box in SERP, pointing at the
  native Shopify search path.

  Scoped to production-like page types only, so it does not leak into
  checkout, account, or customer-area templates.
{%- endcomment -%}

{%- comment -%}
  Default OG image fallback. Horizon's shipped meta-tags snippet only
  emits og:image when a Shopify-level page_image is set -- destination
  metaobject pages, products and collections without a set image
  previously got no og:image at all, because this block used to be
  scoped to the same narrow page-type list as the WebSite JSON-LD below
  (which is a separate, unrelated concern). Broadened to every indexable
  canonical page type, and explicitly gated on page_image being blank
  so this can never render alongside meta-tags.liquid's own og:image tag
  -- exactly one og:image tag reaches the page either way.
{%- endcomment -%}
{%- if page_image == blank and request.page_type != 'cart' and request.page_type != 'search' and request.page_type != 'password' and request.page_type != '404' -%}
<meta property="og:image" content="{{ 'longeva-og-default.png' | asset_url | prepend: 'https:' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Longeva Wellness · GPhC-registered pharmacy in Manchester">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ 'longeva-og-default.png' | asset_url | prepend: 'https:' }}">
{%- endif -%}

{%- if request.page_type == 'index'
   or request.page_type == 'page'
   or request.page_type == 'article'
   or request.page_type == 'blog'
   or request.page_type == 'list-collections'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "{{ shop.url }}/#website",
  "name": "Longeva",
  "alternateName": "Longeva Wellness",
  "url": "{{ shop.url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}
