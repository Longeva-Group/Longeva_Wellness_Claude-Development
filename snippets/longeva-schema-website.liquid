{%- comment -%}
  Sitewide WebSite schema with SearchAction.

  Rendered from layout/theme.liquid so it ships on every page. Gives
  Google the potential sitelinks search box in SERP, pointing at the
  native Shopify search path.

  Scoped to production-like page types only, so it does not leak into
  checkout, account, or customer-area templates.
{%- endcomment -%}

{%- if request.page_type == 'index'
   or request.page_type == 'page'
   or request.page_type == 'article'
   or request.page_type == 'blog'
   or request.page_type == 'list-collections'
-%}
{%- comment -%}
  Default OG image fallback. Horizon's shipped meta-tags snippet
  only emits og:image when a Shopify-level page_image is set. If
  Anthony has not uploaded a brand cover in Settings > Brand, our
  own default asset steps in so social previews never render the
  Shopify placeholder bag. Open Graph consumers use the first
  og:image they encounter in the document; we render AFTER
  meta-tags (this snippet is included later in theme.liquid), so
  an admin-uploaded image still wins because it appears first.
{%- endcomment -%}
<meta property="og:image" content="{{ 'longeva-og-default.png' | asset_url | prepend: 'https:' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Longeva Clinic · GPhC-registered pharmacy in Manchester">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ 'longeva-og-default.png' | asset_url | prepend: 'https:' }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Longeva",
  "alternateName": "Longeva Clinic",
  "url": "{{ shop.url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
{%- endif -%}
