{%- comment -%}
  JSON-LD for a Longeva destination metaobject page. Per
  destination-metaobject-spec.md §6, upgraded 27 May 2026 per
  competitor SERP audit (none of 9 UK competitors use MedicalWebPage
  + Pharmacy + BreadcrumbList stack on destination pages).

  Emits a single node with @type ["WebPage", "MedicalWebPage"]:
    about:           Place + addressCountry (ISO 3166-1 alpha-2)
    lastReviewed:    ISO date from metaobject.last_reviewed_date
    reviewedBy:      Person named pharmacist OR "the Longeva pharmacy team"
    provider:        Pharmacy + MedicalBusiness with GPhC identifier
    medicalAudience: Patient
    specialty:       MedicalSpecialty "Travel Medicine"
    breadcrumb:      3-level Home > Travel vaccinations > {country}

  MedicalWebPage is a subclass of WebPage so dual-typing keeps generic
  rich-result eligibility and adds YMYL clinical-content signalling.

  Requires the `metaobject` Liquid drop. Renders nothing if not present.
{%- endcomment -%}

{%- if metaobject and metaobject.country != blank -%}
  {%- liquid
    assign country_name = metaobject.country | strip
    assign summary_plain = metaobject.summary | metafield_tag | strip_html | strip_newlines | strip
    assign reviewer = metaobject.reviewed_by_pharmacist | strip
    if reviewer == blank
      assign reviewer = 'the Longeva pharmacy team'
    endif
    assign reviewed_iso = metaobject.last_reviewed_date | date: '%Y-%m-%d'
    assign iso2 = metaobject.iso_code | strip | upcase
    assign page_url = shop.url | append: '/pages/destinations/' | append: metaobject.system.handle
    assign gphc_num = settings.longeva_gphc_number | default: '9012378'
    comment
      Count valid FAQ entries (question and answer both set), mirroring
      the section gating, so FAQPage structured data is emitted only when
      the page actually renders an answered FAQ accordion.
    endcomment
    assign destination_faqs = metaobject.faq.value
    assign valid_faqs = 0
    if destination_faqs
      for faq_item in destination_faqs
        if faq_item.question != blank and faq_item.answer != blank
          assign valid_faqs = valid_faqs | plus: 1
        endif
      endfor
    endif
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["WebPage", "MedicalWebPage"],
  "name": {{ 'Travel Vaccinations for ' | append: country_name | json }},
  "description": {{ summary_plain | json }},
  "url": {{ page_url | json }},
  "lastReviewed": {{ reviewed_iso | json }},
  "reviewedBy": {
    "@type": "Person",
    "name": {{ reviewer | json }},
    "jobTitle": "GPhC-registered pharmacist"
  },
  "audience": {
    "@type": "MedicalAudience",
    "audienceType": "Patient"
  },
  "specialty": {
    "@type": "MedicalSpecialty",
    "name": "Travel Medicine"
  },
  "about": {
    "@type": "Place",
    "name": {{ country_name | json }}{%- if iso2 != blank -%},
    "address": {
      "@type": "PostalAddress",
      "addressCountry": {{ iso2 | json }}
    }
    {%- endif -%}
  },
  "isPartOf": {
    "@type": "WebSite",
    "name": "Longeva Wellness",
    "url": {{ shop.url | json }}
  },
  "provider": {
    "@type": ["Pharmacy", "MedicalBusiness"],
    "@id": "{{ shop.url }}/#pharmacy",
    "name": "Longeva Wellness",
    "url": {{ shop.url | json }},
    "identifier": [
      {
        "@type": "PropertyValue",
        "name": "GPhC pharmacy registration",
        "value": {{ gphc_num | json }}
      }
    ]
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": "Travel vaccinations", "item": "{{ shop.url }}/pages/travel-vaccinations" },
      { "@type": "ListItem", "position": 3, "name": {{ country_name | json }}, "item": {{ page_url | json }} }
    ]
  }
}
</script>
  {%- if valid_faqs > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en-GB",
  "mainEntity": [
    {%- assign first = true -%}
    {%- for faq_item in destination_faqs -%}
      {%- if faq_item.question != blank and faq_item.answer != blank -%}
        {%- unless first %},{% endunless -%}
        {%- assign first = false -%}
        {
          "@type": "Question",
          "name": {{ faq_item.question | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ faq_item.answer | metafield_tag | strip_html | strip_newlines | json }} }
        }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
  {%- endif -%}
{%- endif -%}
