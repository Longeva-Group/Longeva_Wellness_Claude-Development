{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
{%- comment -%}
  theme-color is set in layout/theme.liquid:19 with the brand value.
  Removed Horizon's empty placeholder which would otherwise blank it.
{%- endcomment -%}

{%- liquid
  # Longeva SEO cascade. Drives <title>, meta description and og:* from a
  # consistent fallback chain so every page surfaces keyword-bearing,
  # geo-anchored copy even when the admin SEO panel is blank. Source of
  # truth: page_title / page_description (Shopify admin SEO fields) >
  # page.metafields.custom.lede > sensible per-template default.

  assign brand_suffix = ' | ' | append: shop.name

  # 1. Description fallback chain.
  assign cascade_description = page_description
  if cascade_description == blank and request.page_type == 'page' and page
    assign lede_text = page.metafields.custom.lede | strip | strip_newlines
    if lede_text != blank
      assign cascade_description = lede_text
    endif
  endif
  if cascade_description == blank and request.page_type == 'metaobject' and metaobject
    # Destination metaobject pages (/pages/destinations/{handle}) have no
    # `page` object and so never hit the branch above; their SEO summary
    # lives on the metaobject itself (same field longeva-destination-jsonld.liquid
    # reads for its own description).
    assign metaobject_summary_text = metaobject.summary | metafield_tag | strip_html | strip_newlines | strip
    if metaobject_summary_text != blank
      assign cascade_description = metaobject_summary_text
    endif
  endif
  if cascade_description == blank
    assign cascade_description = shop.description
  endif

  # 2. Title with brand suffix and per-template defaults. Admin-set title
  # always wins. The default for the homepage is anchored to Manchester +
  # the pharmacist-led positioning so the head term is owned even before
  # admin customises.

  # 2a. Geo append. Service-page + hub-template pages SHOULD carry "in
  # Manchester" in the SERP title for local-pack eligibility, but only
  # when:
  #   - admin has not set a custom title_tag (page_title == page.title)
  #   - the page title does not already contain "Manchester"
  # This keeps admin overrides authoritative and prevents accidental
  # duplication like "Anti-wrinkle injections Manchester in Manchester".
  assign geo_append = false
  if request.page_type == 'page' and page
    assign tsuffix = page.template_suffix | default: ''
    if page_title == page.title
      if tsuffix == 'service-page' or tsuffix contains 'hub'
        unless page.title contains 'Manchester' or page.title contains 'manchester'
          assign geo_append = true
        endunless
      endif
    endif
  endif

  # BK-02 (Varsha May 2026): match cart by ANY of three signals
  # because request.page_type sometimes returns the templated string
  # 'cart' but other Shopify routes may not. Also match request.path
  # and template.name as belt-and-braces.
  assign _is_cart_route = false
  if request.page_type == 'cart' or template.name == 'cart' or request.path == '/cart' or request.path contains '/cart'
    assign _is_cart_route = true
  endif

  # Brand-duplication guard: saved SEO titles in this store are commonly
  # authored ending in the short brand "Longeva" alone (not the full
  # shop.name "Longeva Wellness"), so the original `contains shop.name`
  # check missed them and appended the full brand suffix again, producing
  # "... | Longeva | Longeva Wellness". Checking for the shorter "Longeva"
  # token catches both forms without stripping or rewriting the saved
  # title itself.
  if _is_cart_route
    assign cascade_title = 'Bookings' | append: brand_suffix
  elsif page_title contains 'Longeva'
    assign cascade_title = page_title
  elsif page_title != blank
    if geo_append
      assign cascade_title = page_title | append: ' in Manchester' | append: brand_suffix
    else
      assign cascade_title = page_title | append: brand_suffix
    endif
  elsif request.page_type == 'index'
    assign cascade_title = 'Pharmacist-led clinical services in Manchester' | append: brand_suffix
  else
    assign cascade_title = shop.name
  endif

  # BK-02 brute-force safety net (Varsha May 2026). If `request.page_type`
  # and friends silently fail to match the cart route (Shopify oddly
  # doesn't expose request inside some head-render contexts), catch
  # whatever Shopify did pass through `page_title` and overwrite when it
  # looks like the cart's default locale string.
  if cascade_title contains 'Shopping' or cascade_title contains 'Cart' or cascade_title contains 'Basket' or cascade_title contains 'cart' or cascade_title contains 'basket'
    assign cascade_title = 'Bookings' | append: brand_suffix
  endif

  # 3. Open Graph computed values.
  assign og_title = cascade_title
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = cascade_description | default: shop.name

  comment
    Booking/consultation products (deposit-model vaccines, minor
    ailments such as Adrenaline Nasal Spray) are Sesami booking
    objects, not retail goods — og:type "product" plus a price reads
    as merchandising a treatment/medicine for sale. Same detection
    already shipped on the cart page and in snippets/price.liquid.
  endcomment
  assign longeva_is_booking_product = false
  if request.page_type == 'product'
    if product.template_suffix == 'service' or product.template_suffix == 'vaccine' or product.metafields.custom.is_service.value == true
      assign longeva_is_booking_product = true
    elsif product.tags contains 'sesami-service' or product.tags contains 'booking' or product.tags contains 'consultation'
      assign longeva_is_booking_product = true
    else
      assign longeva_ptype = product.type | downcase
      if longeva_ptype contains 'consult' or longeva_ptype contains 'service' or longeva_ptype contains 'appointment' or longeva_ptype contains 'vaccine' or longeva_ptype contains 'aesthetic'
        assign longeva_is_booking_product = true
      endif
    endif
  endif

  if request.page_type == 'product' and longeva_is_booking_product == false
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:locale"
  content="en_GB"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' and longeva_is_booking_product == false -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- comment -%}
  BK-02 (Varsha May 2026) — cart route gets a hardcoded "Bookings | shop"
  title. Inline at the title emission point to bypass any cascade
  evaluation oddity. The page is /cart; Shopify's `cart_title` locale
  string is gitignored from theme pushes so we can't fix it there.
{%- endcomment -%}
{%- liquid
  assign _route_url = canonical_url | default: request.origin | downcase
  assign _is_cart = false
  if request.page_type == 'cart'
    assign _is_cart = true
  endif
  if template.name == 'cart'
    assign _is_cart = true
  endif
  if _route_url contains '/cart'
    assign _is_cart = true
  endif
  if cart and cart.token != blank and cascade_title contains 'Cart'
    assign _is_cart = true
  endif
  if cascade_title contains 'Shopping' or cascade_title contains 'Basket'
    assign _is_cart = true
  endif
-%}

{%- if _is_cart -%}
<title>Bookings | {{ shop.name }}</title>
{%- else -%}
<title>
  {{- cascade_title -}}
  {%- if current_tags %} · tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} · Page {{ current_page }}{% endif -%}
</title>
{%- endif -%}

{%- comment -%}
  Travel-vaccinations regional pages: africa-safari, east-africa and
  west-africa are curated destination subsets wholly contained within
  the broader "Africa" region page; south-asia and south-east-asia are
  subsets of "Asia". Canonicalise the subset pages to their parent
  region page instead of noindexing them outright, so each keeps its
  own URL/content for direct/campaign traffic while search engines
  consolidate ranking signal onto the broader page. Assumes the parent
  page's handle follows this theme's template-suffix naming convention
  (page.travel-vaccinations-africa.json / -asia.json); confirm the
  actual Shopify Page handle in Admin if it was ever set differently.
{%- endcomment -%}
{%- liquid
  assign longeva_canonical = canonical_url
  if template.suffix == 'travel-vaccinations-africa-safari' or template.suffix == 'travel-vaccinations-east-africa' or template.suffix == 'travel-vaccinations-west-africa'
    assign longeva_canonical = shop.url | append: '/pages/travel-vaccinations-africa'
  elsif template.suffix == 'travel-vaccinations-south-asia' or template.suffix == 'travel-vaccinations-south-east-asia'
    assign longeva_canonical = shop.url | append: '/pages/travel-vaccinations-asia'
  endif
-%}
<link
  rel="canonical"
  href="{{ longeva_canonical }}"
>

{% if cascade_description != blank %}
  <meta
    name="description"
    content="{{ cascade_description | escape }}"
  >
{% endif %}
