{%- comment -%}
  JSON-LD for a Longeva service page. Renders a MedicalBusiness-scoped
  Service node plus a FAQPage node when the layout section has FAQ
  blocks.

  Called from longeva-service-layout.liquid. Reads the same page
  metafields the layout itself reads. Silently renders nothing when
  invoked from a non-page context.

  Deliberately avoids naming POMs per §3.2. The service name comes
  from the page title stripped of the " Manchester" suffix; the
  description prefers the `lede` metafield; category comes from the
  custom.category metafield.
{%- endcomment -%}

{%- liquid
  assign display_title = page.title | remove: ' Manchester' | strip
  assign lede = page.metafields.custom.lede
  assign category = page.metafields.custom.category
  assign price_from = page.metafields.custom.price_from | strip
  assign price_norm = price_from | downcase
  assign price_is_placeholder = false
  if price_norm == '' or price_norm == 'enquire' or price_norm == 'enquiry' or price_norm == 'tbc' or price_norm == 'tba'
    assign price_is_placeholder = true
  endif

  comment
    Handle-based hub fallback when custom.category is blank (added
    2026-05-12). Keeps the schema
    BreadcrumbList at 3-level depth whenever the page handle clearly
    belongs to a known hub. Falls back to 2-level only when neither
    the metafield nor the handle gives us a confident answer. Mirrors
    the same chain used by sections/longeva-service-breadcrumb.liquid
    so the on-page and JSON-LD breadcrumbs always agree.
  endcomment
  assign hub_handle = ''
  if category != blank
    assign hub_handle = category | handleize | append: '-manchester'
  elsif page.handle contains 'vaccination' or page.handle contains 'vaccine'
    assign hub_handle = 'vaccinations-manchester'
  elsif page.handle contains 'weight-management' or page.handle contains 'alcohol-reduction' or page.handle contains 'smoking-cessation'
    assign hub_handle = 'weight-management-manchester'
  elsif page.handle contains 'anti-wrinkle' or page.handle contains 'dermal-filler' or page.handle contains 'chemical-peel' or page.handle contains 'microneedling' or page.handle contains 'thread-lift' or page.handle contains 'fat-dissolve' or page.handle contains 'skin-booster'
    assign hub_handle = 'aesthetics-manchester'
  elsif page.handle contains 'acne' or page.handle contains 'rosacea' or page.handle contains 'eczema' or page.handle contains 'dermatitis' or page.handle contains 'psoriasis' or page.handle contains 'cold-sore' or page.handle contains 'facial-hair' or page.handle contains 'hair-loss'
    assign hub_handle = 'skin-health-manchester'
  endif
  assign hub_page = pages[hub_handle]
  # Google Breadcrumbs requires a non-empty name on every itemListElement.
  # hub_page.title runs through 'remove' filters below; guard the result
  # so a hub whose title strips down to nothing can't emit a blank-name
  # ListItem -- fall back to the 2-level breadcrumb instead.
  assign hub_crumb_name = ''
  if hub_page
    assign hub_crumb_name = hub_page.title | remove: ' in Manchester' | remove: ' Manchester' | strip
  endif

  assign clinicians_list = page.metafields.custom.clinicians.value
  assign clinician_name_fallback = page.metafields.custom.clinician_name | strip
  assign last_reviewed = page.metafields.custom.last_reviewed
  assign reviewer = page.metafields.custom.reviewed_by.value
  assign reviewer_name = ''
  assign reviewer_gphc = ''
  if reviewer
    assign reviewer_name = reviewer.name
    assign reviewer_gphc = reviewer.gphc_number
  endif
-%}

{%- comment -%}
  FAQPage JSON-LD intentionally NOT emitted here. It lives in
  longeva-service-layout.liquid because that section has access to
  FAQ blocks at runtime. Emitting FAQ from both was a duplicate.
{%- endcomment -%}

{%- if display_title != blank and request.page_type == 'page' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}" }
    {%- if hub_page and hub_crumb_name != blank -%}
    ,
    { "@type": "ListItem", "position": 2, "name": {{ hub_crumb_name | json }}, "item": "{{ shop.url }}{{ hub_page.url }}" },
    { "@type": "ListItem", "position": 3, "name": "{{ display_title | escape }}", "item": "{{ shop.url }}{{ page.url }}" }
    {%- else -%}
    ,
    { "@type": "ListItem", "position": 2, "name": "{{ display_title | escape }}", "item": "{{ shop.url }}{{ page.url }}" }
    {%- endif -%}
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["MedicalProcedure", "Service"],
  "@id": "{{ shop.url }}{{ page.url }}#service",
  "name": {{ display_title | json }},
  "url": "{{ shop.url }}{{ page.url }}",
  {% if lede != blank %}"description": {{ lede | strip | strip_newlines | json }},{% endif %}
  {% if category != blank %}"serviceType": {{ category | json }},{% endif %}
  "provider": {
    "@type": ["Pharmacy", "MedicalBusiness"],
    "@id": "{{ shop.url }}/#pharmacy",
    "name": "Longeva",
    "url": "{{ shop.url }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Unit 1, Chichester Court, Milnrow Road",
      "addressLocality": "Rochdale",
      "postalCode": "OL16 1UG",
      "addressRegion": "Greater Manchester",
      "addressCountry": "GB"
    }
    {%- if clinicians_list and clinicians_list.size > 0 -%},
    "employee": [
      {%- for c in clinicians_list -%}
      {
        "@type": "Person",
        "name": {{ c.name | json }}
        {%- if c.title != blank -%},
        "jobTitle": {{ c.title | json }}
        {%- endif -%}
        {%- if c.gphc_number != blank -%},
        "identifier": [
          { "@type": "PropertyValue", "name": "GPhC pharmacist registration", "value": {{ c.gphc_number | json }} }
        ]
        {%- endif -%}
        {%- if c.headshot -%},
        "image": "https:{{ c.headshot | image_url: width: 480 }}"
        {%- endif -%},
        "worksFor": { "@id": "{{ shop.url }}/#pharmacy" }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
    {%- elsif clinician_name_fallback != blank -%},
    "employee": [
      {
        "@type": "Person",
        "name": {{ clinician_name_fallback | json }},
        "worksFor": { "@id": "{{ shop.url }}/#pharmacy" }
      }
    ]
    {%- endif -%}
  },
  "areaServed": [
    { "@type": "City", "name": "Manchester" },
    { "@type": "AdministrativeArea", "name": "Greater Manchester" }
  ],
  "inLanguage": "en-GB"
  {%- if last_reviewed != blank -%}
  ,
  "dateModified": "{{ last_reviewed | date: '%Y-%m-%d' }}"
  {%- endif -%}
  {%- if reviewer_name != blank -%}
  ,
  "reviewedBy": {
    "@type": "Person",
    "name": {{ reviewer_name | json }}
    {%- if reviewer_gphc != blank -%},
    "identifier": [
      { "@type": "PropertyValue", "name": "GPhC pharmacist registration", "value": {{ reviewer_gphc | json }} }
    ]
    {%- endif -%}
  }
  {%- endif -%}
  {%- if price_is_placeholder == false and price_from != blank -%}
  {%- assign price_numeric = price_from | replace: '£', '' | replace: ',', '' | replace: 'From ', '' | replace: 'from ', '' | strip -%}
  ,
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "{{ price_numeric }}",
    "priceCurrency": "GBP",
    "offerCount": "1",
    "availability": "https://schema.org/InStock",
    "url": "{{ shop.url }}{{ page.url }}"
  }
  {%- endif -%}
}
</script>
{%- comment -%}
  FAQPage JSON-LD moved to longeva-service-layout.liquid so it can
  read faq blocks at section runtime. Keeping the following block
  commented out here so the intent is explicit. Do not re-enable.

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in faq_blocks -%}
    {
      "@type": "Question",
      "name": "{{ block.settings.question | strip | escape }}",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "{{ block.settings.answer | strip_html | strip_newlines | escape }}"
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- endcomment -%}
{%- endif -%}
