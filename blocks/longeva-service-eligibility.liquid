{% comment %}
  Longeva service eligibility block.

  Renders a "who this is for" bullet list from the service metaobject
  (custom.service_ref -> eligibility_bullets). Hidden when no bullets
  are set; the heading can be overridden per-page in the customiser.
{% endcomment %}

{% liquid
  assign service = product.metafields.custom.service_ref.value
  assign bullets = null
  if service and service.eligibility_bullets.value
    assign bullets = service.eligibility_bullets.value
  endif
  assign heading = block.settings.heading | default: "Who it is for"
%}

{% if bullets %}
  <section class="longeva-service-eligibility" {{ block.shopify_attributes }}>
    <h2 class="longeva-service-eligibility__heading">{{ heading | escape }}</h2>
    <ul class="longeva-service-eligibility__list" role="list">
      {% for item in bullets %}
        <li>{{ item | escape }}</li>
      {% endfor %}
    </ul>
  </section>
{% endif %}

{% stylesheet %}
  .longeva-service-eligibility {
    padding-block: 1.5rem;
  }
  .longeva-service-eligibility__heading {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .longeva-service-eligibility__list {
    list-style: disc;
    padding-inline-start: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva eligibility",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who it is for"
    }
  ]
}
{% endschema %}
