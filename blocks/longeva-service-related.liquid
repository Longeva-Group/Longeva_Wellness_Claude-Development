{% comment %}
  Longeva related services grid.

  Pulls the `related_services` list from the service metaobject and
  renders up to 3 cards (name + short description + price + link to the
  matching product page). Hidden when the list is empty.
{% endcomment %}

{% liquid
  assign service = product.metafields.custom.service_ref.value
  assign related = null
  if service and service.related_services.value.size > 0
    assign related = service.related_services.value
  endif
  assign heading = block.settings.heading | default: "You may also like"
  assign max_items = block.settings.max_items | default: 3
%}

{% if related %}
  <section class="longeva-service-related" {{ block.shopify_attributes }}>
    <h2 class="longeva-service-related__heading">{{ heading | escape }}</h2>
    <ul class="longeva-service-related__grid" role="list">
      {% for item in related limit: max_items %}
        {% liquid
          assign item_price = ''
          if item.price_from != blank
            assign item_price = item.price_from | money
          endif
          assign href = '/products/' | append: item.slug
        %}
        <li class="longeva-service-related__card">
          <a class="longeva-service-related__link" href="{{ href }}">
            <p class="longeva-service-related__name">{{ item.name | escape }}</p>
            {% if item.short_description != blank %}
              <p class="longeva-service-related__description">{{ item.short_description | strip_html | truncate: 120 }}</p>
            {% endif %}
            {% if item_price != blank %}
              <p class="longeva-service-related__price">From {{ item_price }}</p>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}

{% stylesheet %}
  .longeva-service-related {
    padding-block: 1.5rem;
  }
  .longeva-service-related__heading {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .longeva-service-related__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .longeva-service-related__card {
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
  }
  .longeva-service-related__link {
    display: block;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
  }
  .longeva-service-related__link:hover,
  .longeva-service-related__link:focus-visible {
    background: var(--color-background-subdued, #f4f4f4);
  }
  .longeva-service-related__name {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .longeva-service-related__description {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-foreground-subdued, currentColor);
  }
  .longeva-service-related__price {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva related",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Max related services to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
