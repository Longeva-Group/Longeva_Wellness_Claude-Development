{% comment %}
  Longeva footer column block. Renders inside sections/longeva-footer.liquid.

  content_type:
    - link_list: heading + menu items from a Shopify menu
    - contact:   heading + short pitch + address + phone + email
    - regulatory: heading + {% render 'longeva-regulatory-footer' %}
{% endcomment %}

{% liquid
  assign heading = block.settings.heading
  assign content_type = block.settings.content_type
  assign menu_handle = block.settings.menu
  assign pitch = block.settings.pitch
  assign phone = block.settings.phone | default: settings.longeva_phone
  assign email = block.settings.email | default: settings.longeva_email
%}

<div
  class="longeva-footer-column"
  {{ block.shopify_attributes }}
>
  {% if heading != blank %}
    <h3 class="longeva-footer-column__heading">{{ heading | escape }}</h3>
  {% endif %}

  {% case content_type %}
    {% when 'link_list' %}
      {% if menu_handle != blank and linklists[menu_handle].links.size > 0 %}
        <ul class="longeva-footer-column__list" role="list">
          {% for link in linklists[menu_handle].links %}
            <li>
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

    {% when 'contact' %}
      {% if pitch != blank %}
        <p class="longeva-footer-column__pitch">{{ pitch }}</p>
      {% endif %}
      {% if phone != blank %}
        <p class="longeva-footer-column__line">
          <a href="tel:{{ phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ phone }}</a>
        </p>
      {% endif %}
      {% if email != blank %}
        <p class="longeva-footer-column__line">
          <a href="mailto:{{ email }}">{{ email }}</a>
        </p>
      {% endif %}

    {% when 'regulatory' %}
      {% render 'longeva-regulatory-footer' %}
  {% endcase %}
</div>

{% stylesheet %}
  .longeva-footer-column__heading {
    font-family: "Poppins", system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-foreground-subdued, rgba(26, 26, 26, 0.66));
  }
  .longeva-footer-column__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .longeva-footer-column__list a {
    color: inherit;
    text-decoration: none;
    font-family: "Poppins", system-ui, sans-serif;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .longeva-footer-column__list a::after {
    content: '\2192';
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    font-size: 13px;
    color: rgba(26, 26, 26, 0.40);
  }
  .longeva-footer-column__list a:hover,
  .longeva-footer-column__list a:focus-visible {
    color: var(--color-foreground, #2D190E);
  }
  .longeva-footer-column__list a:hover::after,
  .longeva-footer-column__list a:focus-visible::after {
    opacity: 1;
    transform: translateX(0);
    color: var(--color-foreground, #2D190E);
  }
  .longeva-footer-column__pitch {
    font-family: "Poppins", system-ui, sans-serif;
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.70);
    max-width: 36ch;
  }
  .longeva-footer-column__line {
    font-family: "Poppins", system-ui, sans-serif;
    margin: 6px 0;
    font-size: 14px;
  }
  .longeva-footer-column__line a {
    color: var(--color-foreground, #2D190E);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s ease;
  }
  .longeva-footer-column__line a:hover,
  .longeva-footer-column__line a:focus-visible {
    color: #1F120A;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .longeva-regulatory {
    font-family: "Poppins", system-ui, sans-serif;
    line-height: 1.5;
    margin: 0;
  }
  .longeva-regulatory__row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block: 10px 0;
    border-block-start: 1px solid rgba(0, 0, 0, 0.06);
    margin-block-start: 10px;
  }
  .longeva-regulatory__row:first-child {
    padding-block-start: 0;
    border-block-start: 0;
    margin-block-start: 0;
  }
  .longeva-regulatory__row dt {
    font-family: "Poppins", system-ui, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground-subdued, rgba(26, 26, 26, 0.66));
    margin: 0;
  }
  .longeva-regulatory__row dd {
    font-size: 14px;
    font-weight: 500;
    color: #1A1A1A;
    margin: 0;
  }
  .longeva-regulatory__complaints {
    margin: 16px 0 0;
    font-size: 13px;
    font-weight: 500;
  }
  .longeva-regulatory__complaints a {
    color: var(--color-foreground, #2D190E);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .longeva-regulatory__complaints a:hover,
  .longeva-regulatory__complaints a:focus-visible {
    color: #1F120A;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva footer column",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Column"
    },
    {
      "type": "select",
      "id": "content_type",
      "label": "Content type",
      "options": [
        { "value": "link_list", "label": "Menu link list" },
        { "value": "contact", "label": "Brand + contact" },
        { "value": "regulatory", "label": "Regulatory display" }
      ],
      "default": "link_list"
    },
    {
      "type": "header",
      "content": "Link list (if Content type = Menu link list)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "header",
      "content": "Contact (if Content type = Brand + contact)"
    },
    {
      "type": "textarea",
      "id": "pitch",
      "label": "Short pitch",
      "info": "40 to 60 words. Appears above the address."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "info": "Shown as tel: link."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "info": "Shown as mailto: link."
    }
  ],
  "presets": [
    {
      "name": "Longeva footer column",
      "settings": {
        "heading": "Column",
        "content_type": "link_list"
      }
    }
  ]
}
{% endschema %}
