{% comment %}
  Longeva service FAQ accordion.

  Reads FAQ entries (faq_item metaobjects) from the service metaobject's
  `faq` list. Renders as <details>/<summary> for native keyboard support.
  Hidden when no FAQ entries.
{% endcomment %}

{% liquid
  assign service = product.metafields.custom.service_ref.value
  assign faq_items = null
  if service and service.faq.value.size > 0
    assign faq_items = service.faq.value
  endif
  assign heading = block.settings.heading | default: "Treatment FAQs"
%}

{% if faq_items %}
  <section class="longeva-service-faq" {{ block.shopify_attributes }}>
    <h2 class="longeva-service-faq__heading">{{ heading | escape }}</h2>
    <div class="longeva-service-faq__list">
      {% for item in faq_items %}
        <details class="longeva-service-faq__item">
          <summary class="longeva-service-faq__question">{{ item.question | escape }}</summary>
          <div class="longeva-service-faq__answer">
            {{ item.answer | metafield_tag }}
          </div>
        </details>
      {% endfor %}
    </div>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for item in faq_items -%}
          {
            "@type": "Question",
            "name": {{ item.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ item.answer | metafield_tag | strip_html | strip_newlines | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>
  </section>
{% endif %}

{% stylesheet %}
  .longeva-service-faq {
    padding-block: 1.5rem;
  }
  .longeva-service-faq__heading {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .longeva-service-faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .longeva-service-faq__item {
    border-block-end: 1px solid var(--color-border);
  }
  .longeva-service-faq__question {
    cursor: pointer;
    font-weight: 500;
    padding-block: 0.75rem;
    list-style: none;
    position: relative;
    padding-inline-end: 2rem;
  }
  .longeva-service-faq__question::-webkit-details-marker {
    display: none;
  }
  .longeva-service-faq__question::after {
    content: "+";
    position: absolute;
    inset-inline-end: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.25rem;
    line-height: 1;
  }
  .longeva-service-faq__item[open] .longeva-service-faq__question::after {
    content: "\2212"; /* minus sign */
  }
  .longeva-service-faq__answer {
    padding-block-end: 1rem;
    line-height: 1.6;
  }
  .longeva-service-faq__answer p:first-child { margin-top: 0; }
  .longeva-service-faq__answer p:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva service FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Treatment FAQs"
    },
    {
      "type": "paragraph",
      "content": "FAQ items come from the service metaobject. Each entry is a faq_item metaobject with question and answer fields."
    }
  ]
}
{% endschema %}
