{% comment %}
  Longeva services grid.

  Title + subtitle, then 4 typographic service cards in a 2x2 grid
  (desktop) or stacked (mobile). Each card is a single link, no
  in-card button. Card colours per brand palette mapping in the
  operating rules on brand spec.
{% endcomment %}

{% render 'longeva-brand-fonts' %}

{%- liquid
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle | default: settings.longeva_home_grid_subtitle
-%}

<section class="longeva-services-grid longeva-page longeva-page--light longeva-section" aria-label="Clinical services">
  <div class="longeva-container">
    {% if heading != blank %}
      <h2 class="longeva-display longeva-services-grid__heading">{{ heading | escape }}</h2>
    {% endif %}
    {% if subtitle != blank %}
      <p class="longeva-services-grid__subtitle">{{ subtitle | escape }}</p>
    {% endif %}

    <ul class="longeva-services-grid__cards" role="list" data-longeva-stagger="70">
      {% for block in section.blocks %}
        <li data-longeva-reveal>
          <a
            class="longeva-services-grid__card"
            href="{{ block.settings.link }}"
            style="--card-bg: {{ block.settings.card_color | default: '#2D190E' }};"
            {{ block.shopify_attributes }}
          >
            <span class="longeva-services-grid__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {% if block.settings.eyebrow != blank %}
              <span class="longeva-services-grid__eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {% endif %}
            <span class="longeva-services-grid__name longeva-display">{{ block.settings.name | escape }}</span>
            {% if block.settings.examples != blank %}
              <span class="longeva-services-grid__examples">{{ block.settings.examples | escape }}</span>
            {% endif %}
            <span class="longeva-services-grid__arrow" aria-hidden="true">
              <svg width="36" height="36" viewBox="0 0 32 32">
                <path d="M8 16h16M18 10l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="longeva-sr-only">Explore {{ block.settings.name | escape }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.view_all_label != blank and section.settings.view_all_url != blank %}
      <p class="longeva-services-grid__view-all">
        <a href="{{ section.settings.view_all_url }}">{{ section.settings.view_all_label | escape }} {% render 'longeva-arrow' %}</a>
      </p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .longeva-services-grid {
    background: #FAFAF7;
  }
  .longeva-services-grid__heading {
    font-size: clamp(32px, 4vw, 44px);
    text-align: center;
    margin: 0;
    color: #1A1A1A;
  }
  .longeva-services-grid__subtitle {
    font-family: var(--longeva-font-body);
    font-size: 18px;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.68);
    max-width: 520px;
    margin: 16px auto 0;
    text-align: center;
  }
  .longeva-services-grid__cards {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .longeva-services-grid__cards > li:last-child:nth-child(3n+1) {
    grid-column: 1 / -1;
  }
  .longeva-services-grid__cards > li:last-child:nth-child(3n+1) .longeva-services-grid__card {
    aspect-ratio: auto;
    min-height: 320px;
  }
  .longeva-services-grid__cards > li:last-child:nth-child(3n+1) .longeva-services-grid__name {
    font-size: clamp(40px, 4.5vw, 56px);
  }
  @media (max-width: 1023px) {
    .longeva-services-grid__cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .longeva-services-grid__cards > li:last-child:nth-child(3n+1) {
      grid-column: auto;
    }
    .longeva-services-grid__cards > li:last-child:nth-child(3n+1) .longeva-services-grid__card {
      aspect-ratio: 4 / 5;
      min-height: 0;
    }
    .longeva-services-grid__cards > li:last-child:nth-child(2n+1) {
      grid-column: 1 / -1;
    }
    .longeva-services-grid__cards > li:last-child:nth-child(2n+1) .longeva-services-grid__card {
      aspect-ratio: auto;
      min-height: 280px;
    }
  }
  .longeva-services-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 5 / 4;
    background: var(--card-bg);
    color: #F2E6DC;
    text-decoration: none;
    padding: 28px 32px 32px;
    border-radius: 2px;
    overflow: hidden;
    transition: transform 0.25s var(--longeva-ease), box-shadow 0.25s var(--longeva-ease);
  }
  .longeva-services-grid__card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.06) 0%, rgba(0,0,0,0.0) 40%, rgba(0,0,0,0.18) 100%);
    pointer-events: none;
  }
  .longeva-services-grid__card:hover,
  .longeva-services-grid__card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(26, 26, 26, 0.18);
    outline: none;
  }
  .longeva-services-grid__number {
    display: block;
    font-family: var(--longeva-font-body);
    font-size: 13px;
    letter-spacing: 0.14em;
    color: rgba(245, 241, 234, 0.70);
    position: relative;
    z-index: 1;
  }
  .longeva-services-grid__eyebrow {
    display: block;
    margin-block-start: 8px;
    font-family: var(--longeva-font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(245, 241, 234, 0.85);
    position: relative;
    z-index: 1;
  }
  .longeva-services-grid__view-all {
    margin: 40px 0 0;
    text-align: center;
    font-family: var(--longeva-font-body);
    font-size: 15px;
  }
  .longeva-services-grid__view-all a {
    color: #1A1A1A;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .longeva-services-grid__view-all a:hover,
  .longeva-services-grid__view-all a:focus-visible {
    color: #2D190E;
  }
  .longeva-services-grid__name {
    display: block;
    margin-block-start: auto;
    margin-block-end: 8px;
    max-inline-size: calc(100% - 64px);
    font-size: clamp(30px, 2.8vw, 38px);
    line-height: 1.02;
    position: relative;
    z-index: 1;
  }
  .longeva-services-grid__examples {
    display: block;
    max-inline-size: calc(100% - 64px);
    font-family: var(--longeva-font-body);
    font-size: 14px;
    color: rgba(245, 241, 234, 0.72);
    line-height: 1.45;
    position: relative;
    z-index: 1;
  }
  .longeva-services-grid__arrow {
    position: absolute;
    inset-inline-end: 24px;
    inset-block-end: 24px;
    width: 44px; height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s var(--longeva-ease);
    z-index: 1;
  }
  .longeva-services-grid__card:hover .longeva-services-grid__arrow,
  .longeva-services-grid__card:focus-visible .longeva-services-grid__arrow {
    transform: translateX(3px);
  }

  @media (max-width: 749px) {
    .longeva-services-grid__cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .longeva-services-grid__card {
      padding: 24px;
      aspect-ratio: auto;
      min-height: 200px;
    }
    .longeva-services-grid__name {
      max-inline-size: calc(100% - 56px);
      font-size: 28px;
    }
    .longeva-services-grid__examples {
      max-inline-size: calc(100% - 56px);
    }
    .longeva-services-grid__arrow {
      inset-inline-end: 16px;
      inset-block-end: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva services grid",
  "tag": "section",
  "class": "longeva-services-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical services"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle (overrides Longeva copy theme setting)"
    },
    {
      "type": "header",
      "content": "View all link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "View all services"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View-all URL"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "card",
      "name": "Service card",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional, small caps above name)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Aesthetics" },
        { "type": "textarea", "id": "examples", "label": "Examples (comma-separated)", "default": "Anti-Wrinkle · Dermal fillers · Skin boosters" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "card_color", "label": "Card colour", "default": "#2D190E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Longeva services grid",
      "settings": {
        "heading": "Clinical services",
        "view_all_label": "View all services",
        "view_all_url": "/pages/services-manchester"
      },
      "blocks": [
        {
          "type": "card",
          "settings": {
            "name": "Aesthetics",
            "examples": "Anti-Wrinkle · Dermal fillers · Skin boosters",
            "link": "/pages/aesthetics-manchester",
            "card_color": "#2D190E"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "Skin Health",
            "examples": "Acne · Rosacea · Eczema",
            "link": "/pages/skin-health-manchester",
            "card_color": "#B99157"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "Travel Health",
            "examples": "Vaccines · Antimalarials · Consultations",
            "link": "/pages/travel-health-manchester",
            "card_color": "#2C4A47"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "Weight Management",
            "examples": "Pharmacist assessment · Ongoing review",
            "link": "/pages/weight-management-manchester",
            "card_color": "#2A2A2A"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "Vaccinations",
            "examples": "Flu · Travel · Shingles",
            "link": "/pages/vaccinations-manchester",
            "card_color": "#2D190E"
          }
        },
        {
          "type": "card",
          "settings": {
            "name": "Minor Ailments",
            "examples": "UTI · Sore throat · Hay fever",
            "link": "/pages/minor-ailments-manchester",
            "card_color": "#2C4A47"
          }
        }
      ]
    }
  ]
}
{% endschema %}
