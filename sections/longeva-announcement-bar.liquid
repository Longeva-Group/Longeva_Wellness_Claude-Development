{% comment %}
  Longeva announcement bar.

  Single-slide, dismissible. Static content until Task 09 wires
  opening hours to metaobject data. Drop into the header section group
  via the admin theme customiser; not wired into header-group.json so
  the Horizon default is not touched.
{% endcomment %}

{% liquid
  assign text = section.settings.text
  assign link = section.settings.link
  assign dismiss_label = section.settings.dismiss_label | default: 'Dismiss'
  assign storage_key = 'longeva-announcement-dismissed-v' | append: section.settings.version
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<aside
  class="longeva-announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %};"
  data-longeva-announcement
  data-storage-key="{{ storage_key }}"
  aria-label="Site announcement"
>
  <div class="longeva-announcement-bar__inner">
    <p class="longeva-announcement-bar__text">
      {% if link != blank %}
        <a href="{{ link }}" class="longeva-announcement-bar__link">{{ text }}</a>
      {% else %}
        {{ text }}
      {% endif %}
    </p>

    {% if section.settings.dismissible %}
      <button
        type="button"
        class="longeva-announcement-bar__dismiss"
        aria-label="{{ dismiss_label }}"
        data-longeva-announcement-dismiss
      >
        {% render 'icon', icon: 'close' %}
      </button>
    {% endif %}
  </div>
</aside>

<script>
  (function () {
    var roots = document.querySelectorAll('[data-longeva-announcement]');
    roots.forEach(function (root) {
      var key = root.getAttribute('data-storage-key');
      try {
        if (key && localStorage.getItem(key) === '1') {
          root.hidden = true;
          return;
        }
      } catch (e) { /* localStorage unavailable; render as normal */ }

      var btn = root.querySelector('[data-longeva-announcement-dismiss]');
      if (!btn) return;
      btn.addEventListener('click', function () {
        root.hidden = true;
        try { if (key) localStorage.setItem(key, '1'); } catch (e) {}
      });
    });
  })();
</script>

{% stylesheet %}
  .longeva-announcement-bar {
    border-block-end: 1px solid var(--color-border);
  }
  .longeva-announcement-bar[hidden] { display: none; }
  .longeva-announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    position: relative;
  }
  .longeva-announcement-bar__text {
    margin: 0;
    text-align: center;
    font-size: var(--font-size--sm, 0.875rem);
  }
  .longeva-announcement-bar__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .longeva-announcement-bar__dismiss {
    position: absolute;
    inset-inline-end: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .longeva-announcement-bar__dismiss:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  /* Phone-class viewports: keep the bar to a single line, ellipsis-truncate
     so it never eats two rows of fold. CRO research: announcement bars
     wrapping to two lines lose 8% of mobile fold. */
  @media (max-width: 480px) {
    .longeva-announcement-bar__text {
      font-size: 11px;
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      padding-inline: 1.25rem;
      max-width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva announcement bar",
  "tag": "section",
  "class": "longeva-announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "GPhC-registered pharmacy. Manchester and UK-wide delivery."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow visitors to dismiss",
      "default": true
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Dismiss button label (for screen readers)",
      "default": "Dismiss announcement"
    },
    {
      "type": "text",
      "id": "version",
      "label": "Dismiss version",
      "info": "Bump this value to re-show a previously dismissed announcement to visitors.",
      "default": "1"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "Colour scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Longeva announcement bar",
      "settings": {
        "text": "GPhC-registered pharmacy. Rochdale. Open 9am to 6pm today.",
        "dismissible": true,
        "version": "1"
      }
    }
  ]
}
{% endschema %}
