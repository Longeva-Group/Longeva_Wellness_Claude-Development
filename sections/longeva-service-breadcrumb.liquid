{% comment %}
  Longeva service breadcrumb.

  Three-level breadcrumb rendered at the top of service pages:
    Home / <Category hub link> / <Current page title>

  Hub resolution: the page's `custom.category` metafield is handleised
  (downcase, spaces to hyphens), then "-manchester" is appended and
  the hub page is looked up via pages[handle]. If the hub page is
  missing the category still renders as plain text rather than a
  broken link.

  Fallback chain when `custom.category` is blank (added 2026-05-12 to
  prevent a recurring breadcrumb-depth-2 bug caused by the same
  `{% if category %}` gate):
    1. Use `custom.category` metafield if present
    2. Else fall back to a category inferred from the page handle
       suffix (vaccination -> Vaccinations, treatment -> Skin Health,
       etc., curated map below to avoid over-eager pattern matching)
    3. Else degrade to a 2-level breadcrumb (Home / Current page)
       rather than vanishing entirely. A 2-level breadcrumb is still
       a better SEO signal than no breadcrumb at all, and the user
       still sees orientation context.

  Separators use "/" wrapped in aria-hidden; no em or en dashes and
  no arrow glyphs.
{% endcomment %}

{% render 'longeva-brand-fonts' %}

{%- liquid
  assign category = page.metafields.custom.category
  assign show_home = section.settings.show_home
  assign home_label = section.settings.home_label | default: 'Home'

  comment
    Handle-based fallback: keyword -> (Category label, hub handle).
    Order matters: most specific suffix first. The map covers every
    suffix used across the current 70 service handles. Each entry is
    a conservative inference, not a guess: if a service handle does
    not contain one of these keywords we fall back to 2-level
    breadcrumb rather than guess wrong.
  endcomment
  assign inferred_category = blank
  assign inferred_hub_handle = blank
  if category == blank
    if page.handle contains 'vaccination' or page.handle contains 'vaccine'
      assign inferred_category = 'Vaccinations'
      assign inferred_hub_handle = 'vaccinations-manchester'
    elsif page.handle contains 'weight-management' or page.handle contains 'alcohol-reduction' or page.handle contains 'smoking-cessation'
      assign inferred_category = 'Weight Management'
      assign inferred_hub_handle = 'weight-management-manchester'
    elsif page.handle contains 'anti-wrinkle' or page.handle contains 'dermal-filler' or page.handle contains 'chemical-peel' or page.handle contains 'microneedling' or page.handle contains 'thread-lift' or page.handle contains 'fat-dissolve' or page.handle contains 'skin-booster'
      assign inferred_category = 'Aesthetics'
      assign inferred_hub_handle = 'aesthetics-manchester'
    elsif page.handle contains 'acne' or page.handle contains 'rosacea' or page.handle contains 'eczema' or page.handle contains 'dermatitis' or page.handle contains 'psoriasis' or page.handle contains 'cold-sore' or page.handle contains 'facial-hair' or page.handle contains 'hair-loss'
      assign inferred_category = 'Skin Health'
      assign inferred_hub_handle = 'skin-health-manchester'
    endif
  endif

  assign effective_category = category | default: inferred_category
  if category != blank
    assign hub_handle = category | downcase | replace: ' ', '-' | append: '-manchester'
  else
    assign hub_handle = inferred_hub_handle
  endif
  assign hub = pages[hub_handle]
-%}

<nav class="longeva-service-breadcrumb" aria-label="Breadcrumb">
  <div class="longeva-container longeva-service-breadcrumb__inner">
    <ol class="longeva-service-breadcrumb__list" role="list">
      {% if show_home %}
        <li class="longeva-service-breadcrumb__item">
          <a class="longeva-service-breadcrumb__link" href="{{ routes.root_url }}">{{ home_label | escape }}</a>
          <span class="longeva-service-breadcrumb__sep" aria-hidden="true">/</span>
        </li>
      {% endif %}
      {% if effective_category != blank %}
        <li class="longeva-service-breadcrumb__item">
          {% if hub %}
            <a class="longeva-service-breadcrumb__link" href="{{ hub.url }}">{{ effective_category | escape }}</a>
          {% else %}
            <span class="longeva-service-breadcrumb__plain">{{ effective_category | escape }}</span>
          {% endif %}
          <span class="longeva-service-breadcrumb__sep" aria-hidden="true">/</span>
        </li>
      {% endif %}
      <li class="longeva-service-breadcrumb__item longeva-service-breadcrumb__item--current" aria-current="page">
        <span class="longeva-service-breadcrumb__current">{{ page.title | remove: ' Manchester' | escape }}</span>
      </li>
    </ol>
  </div>
</nav>

{% stylesheet %}
  .longeva-service-breadcrumb {
    background: var(--longeva-bg);
    border-block-end: 1px solid var(--longeva-border);
  }
  .longeva-service-breadcrumb__inner {
    padding-block: 14px;
  }
  .longeva-service-breadcrumb__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    font-family: var(--longeva-font-body);
    font-size: 13px;
    line-height: 1.4;
    color: var(--longeva-text-subdued);
  }
  .longeva-service-breadcrumb__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .longeva-service-breadcrumb__link {
    color: var(--longeva-text-subdued);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .longeva-service-breadcrumb__link:hover,
  .longeva-service-breadcrumb__link:focus-visible {
    color: var(--longeva-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    outline: none;
  }
  .longeva-service-breadcrumb__link:focus-visible {
    outline: 2px solid var(--longeva-focus-ring);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .longeva-service-breadcrumb__plain {
    color: var(--longeva-text-subdued);
  }
  .longeva-service-breadcrumb__current {
    color: var(--longeva-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 52ch;
  }
  .longeva-service-breadcrumb__sep {
    color: var(--longeva-text-quiet);
    padding-inline: 8px;
    user-select: none;
  }
  @media (max-width: 749px) {
    .longeva-service-breadcrumb__list { font-size: 12px; }
    .longeva-service-breadcrumb__sep { padding-inline: 6px; }
    .longeva-service-breadcrumb__current { max-width: 24ch; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva breadcrumb",
  "tag": "section",
  "class": "longeva-service-breadcrumb-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Show home link",
      "default": true
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home link label",
      "default": "Home"
    }
  ],
  "presets": [
    { "name": "Longeva breadcrumb" }
  ]
}
{% endschema %}
