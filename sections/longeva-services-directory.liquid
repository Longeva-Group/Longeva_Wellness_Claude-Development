{% comment %}
  Longeva services directory. Metafield-driven.

  Inventory (which pages appear) is editable via the section setting
  `handles` (newline-separated). Categorisation (which group each page
  goes into) is driven by each page's `custom.category` metafield; no
  mapping lives in Liquid.

  Presentational category order is defined as a fixed array below.
  That is ordering, not content, so keeping it in Liquid is acceptable.
{% endcomment %}

{% render 'longeva-brand-fonts' %}

{%- liquid
  assign heading = section.settings.heading
  assign lede = section.settings.lede
  assign show_empty = section.settings.show_empty_categories
  assign raw_handles = section.settings.handles | default: ''
  assign handles = raw_handles | newline_to_br | replace: '<br />', '|' | replace: '<br>', '|' | split: '|'

  assign categories = 'Aesthetics|Skin Health|Weight Management|Travel Health|Vaccinations|Sexual Health|Minor Ailments' | split: '|'

  assign hub_by_category = 'Aesthetics:aesthetics-manchester|Skin Health:skin-health-manchester|Weight Management:weight-management-manchester|Travel Health:travel-health-manchester|Vaccinations:vaccinations-manchester|Sexual Health:sexual-health-manchester|Minor Ailments:minor-ailments-manchester' | split: '|'
-%}

<section class="longeva-directory longeva-page longeva-page--light longeva-section" aria-label="{{ heading | escape }}">
  <div class="longeva-container">
    <nav class="longeva-directory__breadcrumb" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">All services</li>
      </ol>
    </nav>

    {% if heading != blank %}
      <h1 class="longeva-display longeva-directory__heading">{{ heading | escape }}</h1>
    {% endif %}
    {% if lede != blank %}
      <div class="longeva-directory__lede">{{ lede }}</div>
    {% endif %}

    <div class="longeva-directory__controls" data-longeva-directory-controls>
      <label class="longeva-directory__search">
        <svg class="longeva-directory__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
        <input
          type="search"
          class="longeva-directory__search-input"
          placeholder="Search services. Try dermal fillers, Anti-Wrinkle, weight management."
          aria-label="Search services"
          data-longeva-directory-search
        >
      </label>
      <nav class="longeva-directory__nav" aria-label="Service categories">
        <ul role="list">
          {% for category in categories %}
            <li><a href="#{{ category | handleize }}">{{ category | escape }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>

    <p class="longeva-directory__empty" hidden data-longeva-directory-empty>
      No services match that search. Try a shorter term or a condition name.
    </p>

    <script src="{{ 'longeva-directory.js' | asset_url }}" defer></script>

    <div class="longeva-directory__groups">
      {% for category in categories %}
        {%- liquid
          assign category_slug = category | handleize
          assign hub_handle = ''
          for pair in hub_by_category
            assign bits = pair | split: ':'
            if bits[0] == category
              assign hub_handle = bits[1]
              break
            endif
          endfor
        -%}

        {%- comment -%}
          Sort each category alphabetically by display title. Two-pass:
          first build a list of just titles, sort_natural (case-insensitive
          A-Z), then resolve each sorted title back to its handle. Pure
          title sort avoids separator-collision sort bugs (e.g. "Hepatitis
          A + ..." sorting before "Hepatitis A" when a separator char
          beats space in ASCII order).
        {%- endcomment -%}
        {%- assign title_list = '' -%}
        {%- for h in handles -%}
          {%- assign handle = h | strip -%}
          {%- if handle == blank -%}{%- continue -%}{%- endif -%}
          {%- assign pg = pages[handle] -%}
          {%- if pg == blank -%}{%- continue -%}{%- endif -%}
          {%- assign pg_category = pg.metafields.custom.category | default: '' -%}
          {%- if pg_category == category -%}
            {%- assign display_title = pg.title | remove: ' Manchester' -%}
            {%- assign title_list = title_list | append: display_title | append: '|' -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign sorted_titles = title_list | split: '|' | sort_natural -%}

        {%- assign matched = '' -%}
        {%- for sorted_title in sorted_titles -%}
          {%- if sorted_title == blank -%}{%- continue -%}{%- endif -%}
          {%- for h in handles -%}
            {%- assign handle = h | strip -%}
            {%- if handle == blank -%}{%- continue -%}{%- endif -%}
            {%- assign pg = pages[handle] -%}
            {%- if pg == blank -%}{%- continue -%}{%- endif -%}
            {%- assign pg_title = pg.title | remove: ' Manchester' -%}
            {%- if pg_title == sorted_title -%}
              {%- assign matched = matched | append: handle | append: '|' -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
        {%- assign matched_handles = matched | split: '|' -%}

        {% if matched_handles.size > 0 or show_empty %}
          {% render 'longeva-directory-group',
              title: category,
              category_slug: category_slug,
              handles: matched_handles,
              hub_handle: hub_handle %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .longeva-directory__breadcrumb {
    font-family: var(--longeva-font-body);
    font-size: 13px;
    margin-block-end: 24px;
    color: rgba(26, 26, 26, 0.68);
  }
  .longeva-directory__breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .longeva-directory__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .longeva-directory__breadcrumb a:hover,
  .longeva-directory__breadcrumb a:focus-visible {
    color: var(--longeva-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .longeva-directory__breadcrumb [aria-current="page"] {
    color: var(--longeva-text);
  }

  .longeva-directory__heading {
    font-size: clamp(32px, 4vw, 48px);
    margin: 0;
    color: var(--longeva-text);
  }
  .longeva-directory__lede {
    font-family: var(--longeva-font-body);
    font-size: 18px;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.68);
    margin: 12px 0 0;
    max-width: 640px;
  }
  .longeva-directory__lede p:first-child { margin-top: 0; }
  .longeva-directory__lede p:last-child { margin-bottom: 0; }

  .longeva-directory__controls {
    position: sticky;
    top: var(--header-group-height, 80px);
    z-index: 30;
    /* Opaque background + hairline border, no shadow, no backdrop blur.
       Harley-Street tier convention (London Clinic, Spire, Nuffield):
       sticky bars read as a continuation of the page surface, not a
       SaaS overlay. Backdrop-blur was a DTC commodity tell and risked
       WCAG 1.4.3 contrast failure when content scrolled beneath. */
    background: var(--longeva-bg);
    /* Negative inline margin + matching padding lets the bar paint
       over the gutter when scrolled. Token --longeva-container-pad
       lives on .longeva-container in longeva-pages.css. */
    margin-inline: calc(-1 * var(--longeva-container-pad, 24px));
    padding-inline: var(--longeva-container-pad, 24px);
    padding-block: 14px;
    margin-block: 40px 0;
    border-block-end: 1px solid rgba(45, 25, 14, 0.10);
    display: grid;
    grid-template-columns: minmax(260px, 420px) 1fr;
    gap: 24px;
    align-items: center;
    /* Hide-on-scroll-down behaviour. Driver in longeva-directory.js
       toggles .is-hidden when the user scrolls past the 200px fold.
       Translate above the top edge so the bar slides away cleanly
       rather than fading in place. */
    transition: transform 0.22s var(--longeva-ease, ease), opacity 0.22s var(--longeva-ease, ease);
    will-change: transform;
  }
  .longeva-directory__controls.is-hidden {
    transform: translateY(-110%);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .longeva-directory__controls { transition: none; }
  }
  .longeva-directory__search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .longeva-directory__search-icon {
    position: absolute;
    inset-inline-start: 14px;
    color: rgba(26, 26, 26, 0.50);
    pointer-events: none;
  }
  .longeva-directory__search-input {
    width: 100%;
    font-family: var(--longeva-font-body);
    font-size: 15px;
    padding: 12px 16px 12px 42px;
    border: 1px solid rgba(0, 0, 0, 0.14);
    border-radius: 999px;
    background: #fff;
    color: var(--longeva-text);
    transition: border-color 0.15s var(--longeva-ease), box-shadow 0.15s var(--longeva-ease);
  }
  .longeva-directory__search-input::placeholder {
    color: rgba(26, 26, 26, 0.50);
  }
  .longeva-directory__search-input:focus {
    outline: none;
    border-color: var(--longeva-primary);
    box-shadow: 0 0 0 3px rgba(45, 25, 14, 0.10);
  }
  .longeva-directory__nav {
    overflow-x: auto;
  }
  .longeva-directory__nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .longeva-directory__nav a {
    display: inline-flex;
    align-items: center;
    /* Padding bumped to 10px 14px (was 6px 12px) so the chip clears
       WCAG 2.2 AA SC 2.5.8 minimum target size (24x24) on every
       breakpoint and gets close to the preferred 44x44 on touch. */
    padding: 10px 14px;
    font-family: var(--longeva-font-body);
    font-size: 13px;
    color: rgba(26, 26, 26, 0.68);
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid transparent;
    white-space: nowrap;
    transition: background 0.15s var(--longeva-ease), color 0.15s var(--longeva-ease), border-color 0.15s var(--longeva-ease);
  }
  .longeva-directory__nav a:hover,
  .longeva-directory__nav a:focus-visible {
    color: var(--longeva-primary);
    border-color: rgba(45, 25, 14, 0.25);
    outline: none;
  }

  .longeva-directory__empty {
    font-family: var(--longeva-font-body);
    font-size: 15px;
    color: rgba(26, 26, 26, 0.68);
    margin: 32px 0 0;
  }

  .longeva-directory__groups {
    margin-block-start: 40px;
    column-count: 2;
    column-gap: 64px;
  }
  .longeva-directory__group {
    break-inside: avoid;
    page-break-inside: avoid;
    margin-block-end: 48px;
    min-width: 0;
    scroll-margin-top: 200px;
  }
  .longeva-directory__group-heading {
    font-family: var(--longeva-font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    color: var(--longeva-text);
    padding-block-end: 12px;
    border-block-end: 1px solid rgba(0, 0, 0, 0.12);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  /* Heading-as-link: whole category title navigates to the hub. Subtle
     hover treatment so the visual hierarchy stays heading-first, not
     button-first. Arrow inherits colour from the link, slides on hover
     to communicate forward navigation. */
  .longeva-directory__group-heading-link {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s var(--longeva-ease);
  }
  .longeva-directory__group-heading-link:hover,
  .longeva-directory__group-heading-link:focus-visible {
    color: var(--longeva-primary);
    outline: none;
  }
  .longeva-directory__group-heading-link:hover > span:first-child,
  .longeva-directory__group-heading-link:focus-visible > span:first-child {
    text-decoration: underline;
    text-decoration-color: rgba(185, 145, 87, 0.65);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  .longeva-directory__group-heading-link:focus-visible {
    outline: 2px solid var(--longeva-focus-ring);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .longeva-directory__group-heading-arrow {
    display: inline-flex;
    align-items: center;
    color: var(--longeva-accent);
    transition: transform 0.18s var(--longeva-ease);
  }
  .longeva-directory__group-heading-link:hover .longeva-directory__group-heading-arrow,
  .longeva-directory__group-heading-link:focus-visible .longeva-directory__group-heading-arrow {
    transform: translateX(4px);
  }
  .longeva-directory__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .longeva-directory__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    font-family: var(--longeva-font-body);
    font-size: 15px;
    line-height: 1.4;
    color: var(--longeva-text);
    text-decoration: none;
    border-block-end: 1px solid rgba(0, 0, 0, 0.06);
  }
  .longeva-directory__link:last-child,
  .longeva-directory__list li:last-child .longeva-directory__link {
    border-block-end: 0;
  }
  .longeva-directory__link-name {
    flex: 1 1 auto;
    min-width: 0;
  }
  .longeva-directory__link-meta {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: 12px;
    color: rgba(26, 26, 26, 0.66);
    white-space: nowrap;
    flex: 0 0 auto;
  }
  .longeva-directory__link-dot {
    color: rgba(26, 26, 26, 0.30);
  }
  .longeva-directory__link:hover {
    color: var(--longeva-primary);
  }
  .longeva-directory__link:focus-visible {
    color: var(--longeva-primary);
    outline: 2px solid var(--longeva-focus-ring);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .longeva-directory__link:hover .longeva-directory__link-name,
  .longeva-directory__link:focus-visible .longeva-directory__link-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    .longeva-directory__controls {
      grid-template-columns: 1fr;
      gap: 12px;
      top: var(--header-group-height, 64px);
      padding-block: 12px;
    }
    .longeva-directory__nav ul {
      justify-content: flex-start;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-block-end: 4px;
      -webkit-overflow-scrolling: touch;
    }
  }
  @media (max-width: 749px) {
    .longeva-directory__groups {
      column-count: 1;
    }
    .longeva-directory__group {
      margin-block-end: 40px;
      scroll-margin-top: 180px;
    }
    .longeva-directory__link {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .longeva-directory__link-meta {
      font-size: 11px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva directory",
  "tag": "section",
  "class": "longeva-directory-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All services, Manchester"
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede",
      "default": "<p>Every service we offer, grouped by speciality. Pharmacist-led consultations and treatments at our Manchester pharmacy and across the UK.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_empty_categories",
      "label": "Show empty categories",
      "info": "When on, categories with zero matching pages still render as empty headings.",
      "default": false
    },
    {
      "type": "header",
      "content": "Inventory"
    },
    {
      "type": "textarea",
      "id": "handles",
      "label": "Page handles",
      "info": "One handle per line. Grouping is driven by each page's custom.category metafield, not by this list. Presentational category order is fixed in the section (Aesthetics, Skin Health, Weight Management, Travel Health, Vaccinations, Sexual Health, Minor Ailments).",
      "default": "acid-reflux-treatment-manchester\nacne-treatment-manchester\nalcohol-reduction-manchester\naltitude-sickness-treatment-manchester\nanti-wrinkle-injections-manchester\nantiviral-flu-treatment-manchester\nasthma-treatment-manchester\nback-pain-treatment-manchester\nchemical-peels-manchester\nchicken-pox-vaccination-manchester\ncholera-vaccination-manchester\ncold-sore-treatment-manchester\nconjunctivitis-treatment-manchester\ncovid-vaccination-manchester\ndermal-fillers-manchester\ndermatitis-eczema-treatment-manchester\ndiphtheria-vaccination-manchester\near-infection-treatment-manchester\nemergency-hormonal-contraception-manchester\nerectile-dysfunction-manchester\nfacial-hair-removal-manchester\nfat-dissolve-manchester\nflu-vaccination-manchester\nfungal-infection-treatment-manchester\nhaemorrhoids-treatment-manchester\nhair-loss-treatment-manchester\nhay-fever-treatment-manchester\nhepatitis-a-vaccination-manchester\nhepatitis-b-travel-vaccine-manchester\nhepatitis-b-vaccination-manchester\nhives-treatment-manchester\nhpv-vaccination-manchester\nibs-treatment-manchester\nimpetigo-treatment-manchester\njapanese-encephalitis-vaccination-manchester\nmalaria-prevention-manchester\nmeningitis-acwy-vaccination-manchester\nmeningitis-b-vaccination-manchester\nmicroneedling-manchester\nmigraine-treatment-manchester\nmmr-vaccination-manchester\noral-contraception-manchester\nperiod-delay-manchester\nperiod-pain-treatment-manchester\nplaque-psoriasis-treatment-manchester\npneumococcal-vaccination-manchester\npremature-ejaculation-manchester\nrabies-vaccination-manchester\nrosacea-treatment-manchester\nrsv-vaccination-manchester\nscalp-psoriasis-treatment-manchester\nshingles-vaccination-manchester\nskin-boosters-manchester\nsmoking-cessation-manchester\nsore-throat-strep-a-consultation-manchester\ntb-vaccination-manchester\nthread-lift-treatment-manchester\ntick-borne-encephalitis-vaccination-manchester\ntravel-health-consultation-manchester\ntravellers-diarrhoea-manchester\ntyphoid-vaccination-manchester\nurinary-incontinence-manchester\nuti-treatment-manchester\nvitamin-b12-injection-manchester\nweight-management-service-manchester\nwhooping-cough-vaccination-manchester\nyellow-fever-vaccination-manchester"
    }
  ],
  "presets": [
    { "name": "Longeva directory" }
  ]
}
{% endschema %}
