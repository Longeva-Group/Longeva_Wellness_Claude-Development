{%- comment -%}
  Longeva search results page section. Replaces the Horizon
  search-header + search-results stack with a clinical-services-tuned
  layout that groups results by type (services, hub pages,
  information, articles, products) and surfaces helpful next-actions
  in the empty state.

  Form posts to {{ routes.search_url }} so the standard /search
  endpoint resolves the query. Every visible string is admin-tunable
  via section settings.

  Result-binning approach: Liquid does not have efficient grouping,
  so we iterate the paginated result set once per group. The cost
  is bounded by `paginate by 24`; each pass is O(n) over a small n.
{%- endcomment -%}

{%- liquid
  # Cap query at 80 chars so a malicious or accidental very-long search
  # term cannot blow past the H1 container or eat the section visually.
  # Truncation happens after escape-safe assigns; render site applies escape.
  assign query = search.terms | default: '' | strip | truncate: 80
  assign has_query = false
  if search.performed and query != ''
    assign has_query = true
  endif
-%}

<section class="longeva-search longeva-page longeva-page--light">
  <div class="longeva-container longeva-search__inner">
    <header class="longeva-search__header">
      <p class="longeva-eyebrow">{{ section.settings.eyebrow | default: 'Search' | escape }}</p>
      {%- if has_query -%}
        <h1 class="longeva-display longeva-search__title">
          {{ section.settings.results_heading_lede | default: 'Results for' | escape }}
          <span class="longeva-search__title-q">&ldquo;{{ query | escape }}&rdquo;</span>
        </h1>
        <p class="longeva-search__count">
          {%- if search.results_count == 0 -%}
            {{ section.settings.no_results_count | default: 'No matches' | escape }}
          {%- else -%}
            {{ search.results_count }} {%- if search.results_count == 1 -%} result {%- else -%} results {%- endif -%}
          {%- endif -%}
        </p>
      {%- else -%}
        <h1 class="longeva-display longeva-search__title">{{ section.settings.idle_heading | default: 'Search Longeva' | escape }}</h1>
        <p class="longeva-search__lede">{{ section.settings.idle_lede | default: 'Find a service, condition, clinician, or article. Try anti-wrinkle, weight management, travel vaccines.' | escape }}</p>
      {%- endif -%}
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="longeva-search__form" data-longeva-search-form>
      <label class="visually-hidden" for="LongevaSearchQuery">{{ section.settings.input_label | default: 'Search' | escape }}</label>
      <span class="longeva-search__form-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="M20 20l-3.5-3.5"/>
        </svg>
      </span>
      <input
        id="LongevaSearchQuery"
        type="search"
        name="q"
        value="{{ query | escape }}"
        placeholder="{{ section.settings.input_placeholder | default: 'Search treatments, conditions, articles' | escape }}"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        class="longeva-search__form-input"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="longeva-search__form-submit" aria-label="{{ section.settings.submit_label | default: 'Search' | escape }}">
        <span class="visually-hidden">{{ section.settings.submit_label | default: 'Search' | escape }}</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14m-7-7l7 7-7 7"/>
        </svg>
      </button>
    </form>

    {%- if has_query and search.results_count > 0 -%}
      {%- comment -%} Bin results by display group. {%- endcomment -%}
      {%- assign service_handles_csv = section.settings.service_template_suffixes | default: 'service-page' -%}
      {%- assign service_suffixes = service_handles_csv | split: ',' -%}
      {%- assign hub_marker = section.settings.hub_template_marker | default: 'hub' -%}

      {%- paginate search.results by 24 -%}
        {%- comment -%} Pre-pass: count each group so we can hide empty groups. {%- endcomment -%}
        {%- assign service_count = 0 -%}
        {%- assign hub_count = 0 -%}
        {%- assign info_count = 0 -%}
        {%- assign article_count = 0 -%}
        {%- assign product_count = 0 -%}
        {%- assign other_count = 0 -%}
        {%- for r in search.results -%}
          {%- if r.object_type == 'product' -%}
            {%- assign product_count = product_count | plus: 1 -%}
          {%- elsif r.object_type == 'article' -%}
            {%- assign article_count = article_count | plus: 1 -%}
          {%- elsif r.object_type == 'page' -%}
            {%- assign suffix = r.template_suffix | default: '' -%}
            {%- if service_suffixes contains suffix -%}
              {%- assign service_count = service_count | plus: 1 -%}
            {%- elsif suffix contains hub_marker -%}
              {%- assign hub_count = hub_count | plus: 1 -%}
            {%- else -%}
              {%- assign info_count = info_count | plus: 1 -%}
            {%- endif -%}
          {%- else -%}
            {%- comment -%}
              Future Shopify object_type values (e.g. collection,
              blog) land here so they are still surfaced rather than
              silently dropped from the results page.
            {%- endcomment -%}
            {%- assign other_count = other_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        <div class="longeva-search__results">
          {%- if service_count > 0 -%}
            <section class="longeva-search__group" aria-labelledby="LongevaSearchGroupServices">
              <h2 id="LongevaSearchGroupServices" class="longeva-search__group-heading">
                <span>{{ section.settings.group_services | default: 'Services' | escape }}</span>
                <span class="longeva-search__group-count">{{ service_count }}</span>
              </h2>
              <ul class="longeva-search__list" role="list">
                {%- for r in search.results -%}
                  {%- if r.object_type != 'page' -%}{%- continue -%}{%- endif -%}
                  {%- assign suffix = r.template_suffix | default: '' -%}
                  {%- unless service_suffixes contains suffix -%}{%- continue -%}{%- endunless -%}
                  {%- render 'longeva-search-result', r: r, kind: 'service' -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if hub_count > 0 -%}
            <section class="longeva-search__group" aria-labelledby="LongevaSearchGroupHubs">
              <h2 id="LongevaSearchGroupHubs" class="longeva-search__group-heading">
                <span>{{ section.settings.group_hubs | default: 'Treatment areas' | escape }}</span>
                <span class="longeva-search__group-count">{{ hub_count }}</span>
              </h2>
              <ul class="longeva-search__list" role="list">
                {%- for r in search.results -%}
                  {%- if r.object_type != 'page' -%}{%- continue -%}{%- endif -%}
                  {%- assign suffix = r.template_suffix | default: '' -%}
                  {%- if service_suffixes contains suffix -%}{%- continue -%}{%- endif -%}
                  {%- unless suffix contains hub_marker -%}{%- continue -%}{%- endunless -%}
                  {%- render 'longeva-search-result', r: r, kind: 'hub' -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if info_count > 0 -%}
            <section class="longeva-search__group" aria-labelledby="LongevaSearchGroupInfo">
              <h2 id="LongevaSearchGroupInfo" class="longeva-search__group-heading">
                <span>{{ section.settings.group_info | default: 'Information' | escape }}</span>
                <span class="longeva-search__group-count">{{ info_count }}</span>
              </h2>
              <ul class="longeva-search__list" role="list">
                {%- for r in search.results -%}
                  {%- if r.object_type != 'page' -%}{%- continue -%}{%- endif -%}
                  {%- assign suffix = r.template_suffix | default: '' -%}
                  {%- if service_suffixes contains suffix -%}{%- continue -%}{%- endif -%}
                  {%- if suffix contains hub_marker -%}{%- continue -%}{%- endif -%}
                  {%- render 'longeva-search-result', r: r, kind: 'info' -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if article_count > 0 -%}
            <section class="longeva-search__group" aria-labelledby="LongevaSearchGroupArticles">
              <h2 id="LongevaSearchGroupArticles" class="longeva-search__group-heading">
                <span>{{ section.settings.group_articles | default: 'Articles' | escape }}</span>
                <span class="longeva-search__group-count">{{ article_count }}</span>
              </h2>
              <ul class="longeva-search__list" role="list">
                {%- for r in search.results -%}
                  {%- if r.object_type != 'article' -%}{%- continue -%}{%- endif -%}
                  {%- render 'longeva-search-result', r: r, kind: 'article' -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if product_count > 0 -%}
            <section class="longeva-search__group" aria-labelledby="LongevaSearchGroupProducts">
              <h2 id="LongevaSearchGroupProducts" class="longeva-search__group-heading">
                <span>{{ section.settings.group_products | default: 'Products' | escape }}</span>
                <span class="longeva-search__group-count">{{ product_count }}</span>
              </h2>
              <ul class="longeva-search__list" role="list">
                {%- for r in search.results -%}
                  {%- if r.object_type != 'product' -%}{%- continue -%}{%- endif -%}
                  {%- render 'longeva-search-result', r: r, kind: 'product' -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}

          {%- if other_count > 0 -%}
            <section class="longeva-search__group" aria-labelledby="LongevaSearchGroupOther">
              <h2 id="LongevaSearchGroupOther" class="longeva-search__group-heading">
                <span>{{ section.settings.group_other | default: 'More results' | escape }}</span>
                <span class="longeva-search__group-count">{{ other_count }}</span>
              </h2>
              <ul class="longeva-search__list" role="list">
                {%- for r in search.results -%}
                  {%- if r.object_type == 'product' or r.object_type == 'article' or r.object_type == 'page' -%}{%- continue -%}{%- endif -%}
                  {%- render 'longeva-search-result', r: r, kind: 'other' -%}
                {%- endfor -%}
              </ul>
            </section>
          {%- endif -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="longeva-search__pagination" aria-label="Search results pages">
            {%- if paginate.previous -%}
              <a class="longeva-search__pagination-link" href="{{ paginate.previous.url }}" rel="prev">&larr; {{ section.settings.prev_label | default: 'Previous' | escape }}</a>
            {%- endif -%}
            <span class="longeva-search__pagination-pos">{{ section.settings.page_pos_lede | default: 'Page' | escape }} {{ paginate.current_page }} {{ section.settings.page_pos_of | default: 'of' | escape }} {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a class="longeva-search__pagination-link" href="{{ paginate.next.url }}" rel="next">{{ section.settings.next_label | default: 'Next' | escape }} &rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

    {%- elsif has_query -%}
      <div class="longeva-search__empty">
        <h2 class="longeva-search__empty-heading">{{ section.settings.no_results_heading | default: 'Nothing matched that search' | escape }}</h2>
        <p class="longeva-search__empty-lede">{{ section.settings.no_results_lede | default: 'Try a broader term or browse the treatment areas below.' | escape }}</p>
        <p class="longeva-search__empty-quicklinks-label">{{ section.settings.no_results_quicklinks_label | default: 'Browse instead' | escape }}</p>
        <ul class="longeva-search__quicklinks" role="list">
          {%- assign empty_menu = linklists[section.settings.no_results_menu] -%}
          {%- if empty_menu.links.size > 0 -%}
            {%- for link in empty_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/aesthetics-manchester">Aesthetics</a></li>
            <li><a href="/pages/skin-health-manchester">Skin health</a></li>
            <li><a href="/pages/weight-management-manchester">Weight management</a></li>
            <li><a href="/pages/travel-health-manchester">Travel health</a></li>
            <li><a href="/pages/services">All services</a></li>
          {%- endif -%}
        </ul>
      </div>
    {%- else -%}
      <div class="longeva-search__idle">
        <h2 class="longeva-search__idle-heading">{{ section.settings.idle_suggest_heading | default: 'Popular searches' | escape }}</h2>
        <ul class="longeva-search__quicklinks" role="list">
          {%- assign idle_menu = linklists[section.settings.idle_menu] -%}
          {%- if idle_menu.links.size > 0 -%}
            {%- for link in idle_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.search_url }}?q=anti-wrinkle">Anti-wrinkle</a></li>
            <li><a href="{{ routes.search_url }}?q=weight-management">Weight management</a></li>
            <li><a href="{{ routes.search_url }}?q=travel">Travel vaccines</a></li>
            <li><a href="{{ routes.search_url }}?q=skin">Skin health</a></li>
            <li><a href="{{ routes.search_url }}?q=cold-sore">Cold sore</a></li>
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .longeva-search { padding-block: 0; }
  .longeva-search__inner {
    max-width: 920px;
    padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px);
  }
  .longeva-search__header { margin-block-end: 24px; }
  .longeva-search__title {
    font-size: clamp(32px, 5vw, 48px);
    margin: 12px 0 0;
    color: var(--longeva-text);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .longeva-search__title-q {
    color: var(--longeva-primary);
    /* Long queries should wrap inside the brand-dark colour rather
       than overflow the H1 container. */
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .longeva-search__lede {
    font-family: var(--longeva-font-body);
    font-size: 16px;
    line-height: 1.55;
    color: var(--longeva-text-subdued);
    margin: 12px 0 0;
    max-width: 560px;
  }
  .longeva-search__count {
    font-family: var(--longeva-font-body);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--longeva-text-subdued);
    margin: 12px 0 0;
  }

  /* Hairline rectangle search bar (NHS / clinic search bar register)
     rather than a rounded-pill DTC newsletter-style bar. Submit is a
     quiet brass icon button on the trailing edge with a vertical
     hairline divider. The whole bar focuses as one via :focus-within. */
  .longeva-search__form {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: stretch;
    gap: 0;
    margin-block: 28px 40px;
    border: 1px solid var(--longeva-border-mid);
    border-radius: var(--longeva-radius-md);
    background: #fff;
    transition: border-color 0.15s var(--longeva-ease), box-shadow 0.15s var(--longeva-ease);
  }
  .longeva-search__form:focus-within {
    border-color: var(--longeva-primary);
    box-shadow: 0 0 0 3px rgba(45, 25, 14, 0.10);
  }
  .longeva-search__form-icon {
    position: absolute;
    inset-inline-start: 16px;
    inset-block-start: 50%;
    transform: translateY(-50%);
    color: var(--longeva-text-quiet);
    pointer-events: none;
  }
  .longeva-search__form-input {
    border: 0;
    background: transparent;
    font-family: var(--longeva-font-body);
    font-size: 16px;
    padding: 16px 16px 16px 50px;
    color: var(--longeva-text);
    width: 100%;
    /* Reset iOS Safari rounded corners + inset clear-button so the
       icon overlay alignment holds; the wrapping form already has a
       hairline border + focus-within ring. */
    -webkit-appearance: none;
    appearance: none;
  }
  .longeva-search__form-input::placeholder { color: var(--longeva-text-quiet); }
  .longeva-search__form-input::-webkit-search-decoration,
  .longeva-search__form-input::-webkit-search-cancel-button,
  .longeva-search__form-input::-webkit-search-results-button,
  .longeva-search__form-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    display: none;
  }
  .longeva-search__form-input:focus { outline: none; }
  .longeva-search__form-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-inline-start: 1px solid var(--longeva-border);
    background: transparent;
    color: var(--longeva-accent-gold);
    padding: 0 18px;
    min-width: 56px;
    cursor: pointer;
    transition: background 0.15s var(--longeva-ease), color 0.15s var(--longeva-ease);
  }
  .longeva-search__form-submit:hover,
  .longeva-search__form-submit:focus-visible {
    background: rgba(166, 120, 60, 0.08);
    color: var(--longeva-primary);
    outline: none;
  }
  .longeva-search__form-submit:focus-visible {
    box-shadow: inset 0 0 0 2px var(--longeva-focus-ring);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .longeva-search__results { display: flex; flex-direction: column; gap: 48px; }
  .longeva-search__group { min-width: 0; }
  /* 22px to match longeva-services-directory.liquid group heading
     so the system reads as one designer's voice across surfaces. */
  .longeva-search__group-heading {
    font-family: var(--longeva-font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--longeva-text);
    margin: 0 0 16px;
    padding-block-end: 12px;
    border-block-end: 1px solid var(--longeva-border-mid);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .longeva-search__group-count {
    font-family: var(--longeva-font-body);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--longeva-text-subdued);
    text-transform: uppercase;
  }
  .longeva-search__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .longeva-search__result {
    display: grid;
    grid-template-columns: 88px 1fr auto;
    gap: 20px;
    padding-block: 18px;
    border-block-end: 1px solid var(--longeva-border);
    align-items: center;
  }
  .longeva-search__result:last-child { border-block-end: 0; }
  .longeva-search__result--no-thumb { grid-template-columns: 1fr auto; }
  .longeva-search__result-thumb {
    width: 88px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--longeva-radius-md);
    background: rgba(45, 25, 14, 0.04);
    border: 1px solid var(--longeva-border);
  }
  .longeva-search__result-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .longeva-search__result-meta { min-width: 0; }
  .longeva-search__result-eyebrow {
    font-family: var(--longeva-font-body);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--longeva-accent-ink);
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .longeva-search__result-title {
    font-family: var(--longeva-font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.005em;
    margin: 0;
    color: var(--longeva-text);
    line-height: 1.3;
  }
  .longeva-search__result-title a { color: inherit; text-decoration: none; }
  .longeva-search__result-title a:hover,
  .longeva-search__result-title a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--longeva-accent);
    text-underline-offset: 3px;
    outline: none;
  }
  .longeva-search__result-snippet {
    font-family: var(--longeva-font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--longeva-text-subdued);
    margin: 6px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .longeva-search__result-arrow {
    color: var(--longeva-primary);
    align-self: center;
    transition: transform 0.18s var(--longeva-ease), color 0.18s var(--longeva-ease);
    display: inline-flex;
  }
  .longeva-search__result:hover .longeva-search__result-arrow,
  .longeva-search__result:focus-within .longeva-search__result-arrow {
    transform: translateX(4px);
    color: var(--longeva-accent-gold);
  }

  .longeva-search__pagination {
    margin-block-start: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
    border-block-start: 1px solid var(--longeva-border-mid);
    font-family: var(--longeva-font-body);
    font-size: 14px;
  }
  .longeva-search__pagination-link {
    color: var(--longeva-primary);
    text-decoration: underline;
    text-decoration-color: var(--longeva-accent);
    text-underline-offset: 4px;
    padding: 8px 4px;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
  }
  .longeva-search__pagination-link:hover,
  .longeva-search__pagination-link:focus-visible {
    text-decoration-color: var(--longeva-primary);
    outline: none;
  }
  .longeva-search__pagination-pos {
    color: var(--longeva-text-subdued);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .longeva-search__empty,
  .longeva-search__idle {
    margin-block-start: 16px;
    padding-block: clamp(24px, 4vw, 40px);
  }
  /* Empty state: editorial typography, left-aligned with the search
     input above. No glyph; trust the type composition. */
  .longeva-search__empty {
    text-align: start;
    max-width: 560px;
  }
  .longeva-search__empty-heading {
    font-family: var(--longeva-font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.5vw, 32px);
    letter-spacing: -0.01em;
    color: var(--longeva-text);
    margin: 0 0 12px;
    line-height: 1.15;
  }
  .longeva-search__empty-heading::after {
    content: "";
    display: block;
    width: 48px;
    height: 1px;
    background: var(--longeva-accent);
    margin: 16px 0 0;
  }
  .longeva-search__empty-lede {
    font-family: var(--longeva-font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--longeva-text-subdued);
    margin: 16px 0 24px;
  }
  .longeva-search__empty-quicklinks-label {
    font-family: var(--longeva-font-body);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--longeva-text-subdued);
    margin: 0 0 12px;
  }
  .longeva-search__idle-heading {
    font-family: var(--longeva-font-body);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--longeva-text-subdued);
    margin: 0 0 16px;
  }
  .longeva-search__quicklinks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: flex-start;
  }
  .longeva-search__quicklinks a {
    display: inline-flex;
    padding: 10px 16px;
    border: 1px solid var(--longeva-border-mid);
    border-radius: 999px;
    font-family: var(--longeva-font-body);
    font-size: 13px;
    color: var(--longeva-text);
    text-decoration: none;
    transition: background 0.15s var(--longeva-ease), color 0.15s var(--longeva-ease), border-color 0.15s var(--longeva-ease);
  }
  /* Pill quicklinks read as informational links, not CTAs.
     Hover keeps the hairline + deepens text + border, no fill. */
  .longeva-search__quicklinks a:hover,
  .longeva-search__quicklinks a:focus-visible {
    color: var(--longeva-primary);
    border-color: var(--longeva-primary);
    outline: none;
  }
  .longeva-search__quicklinks a:focus-visible {
    box-shadow: 0 0 0 3px rgba(45, 25, 14, 0.10);
  }

  @media (max-width: 600px) {
    .longeva-search__title { font-size: 28px; }
    .longeva-search__form-input { font-size: 16px; padding: 14px 14px 14px 44px; }
    .longeva-search__form-icon { inset-inline-start: 14px; }
    .longeva-search__form-submit { padding: 0 18px; font-size: 13px; }
    .longeva-search__result {
      grid-template-columns: 64px 1fr;
      grid-template-areas:
        "thumb meta"
        "thumb arrow";
      gap: 14px;
      padding-block: 16px;
    }
    .longeva-search__result--no-thumb {
      grid-template-columns: 1fr;
      grid-template-areas:
        "meta"
        "arrow";
    }
    .longeva-search__result-thumb { grid-area: thumb; width: 64px; }
    .longeva-search__result-meta { grid-area: meta; }
    .longeva-search__result-arrow { grid-area: arrow; align-self: end; justify-self: end; }
    .longeva-search__pagination { flex-direction: column; gap: 12px; align-items: center; }
  }
{% endstylesheet %}

