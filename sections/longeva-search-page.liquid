    { "type": "header", "content": "Result binning" },
    { "type": "text", "id": "service_template_suffixes", "label": "Service-page template suffixes (CSV)", "default": "service-page", "info": "Pages with these template_suffix values are binned as Services. Comma-separated, e.g. service-page,treatment-page" },
