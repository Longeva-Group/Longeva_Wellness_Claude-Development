{% comment %}
  Longeva journal preview. Left-aligned heading + "All articles" link on
  the right, 3-card row on desktop, 1-card horizontal scroll on mobile.

  Hidden on the homepage (template == 'index') per Anthony 2026-04-28.
  The Shopify GitHub integration keeps re-adding the section to
  templates/index.json from the admin theme editor's section data, so
  we hard-guard at the section level instead of fighting the JSON file.
  Remove this guard if the homepage block is wanted again.
{% endcomment %}

{% if template.name == 'index' %}{% comment %}early-return for homepage{% endcomment %}{% else %}

{% render 'longeva-brand-fonts' %}

{%- liquid
  assign heading = section.settings.heading
  assign view_all_label = section.settings.view_all_label
  assign blog_handle = section.settings.blog | default: 'journal'
  assign blog = blogs[blog_handle]
  assign limit = section.settings.limit | default: 3
-%}

<section class="longeva-journal longeva-page longeva-page--light longeva-section" aria-label="From the Journal">
  <div class="longeva-container">
    <div class="longeva-journal__top">
      {% if heading != blank %}
        <h2 class="longeva-display longeva-journal__heading">{{ heading | escape }}</h2>
      {% endif %}
      {% if blog %}
        <a class="longeva-journal__view-all" href="{{ blog.url }}">{{ view_all_label | default: 'All articles' | escape }} {% render 'longeva-arrow' %}</a>
      {% endif %}
    </div>

    {% if blog and blog.articles_count > 0 %}
      <ul class="longeva-journal__cards" role="list" data-longeva-stagger="80">
        {% for article in blog.articles limit: limit %}
          <li class="longeva-journal__card" data-longeva-reveal>
            <a class="longeva-journal__card-link" href="{{ article.url }}">
              {%- comment -%}
                Stock imagery breaks §3.1.4 of the brief; render a
                brand panel with the article's first-letter monogram
                until verified clinical photography lands. Toggle
                use_article_image to re-enable raw image fallback.
              {%- endcomment -%}
              {%- assign use_article_image = section.settings.use_article_image -%}
              {% if use_article_image and article.image %}
                <span class="longeva-journal__image">
                  <img
                    src="{{ article.image | image_url: width: 640 }}"
                    srcset="{{ article.image | image_url: width: 640 }} 640w, {{ article.image | image_url: width: 960 }} 960w"
                    sizes="(max-width: 749px) 80vw, 33vw"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                    width="{{ article.image.width }}"
                    height="{{ article.image.height }}"
                  >
                </span>
              {% else %}
                <span class="longeva-journal__image longeva-journal__image--placeholder" aria-hidden="true">
                  <span class="longeva-journal__monogram">{{ article.title | strip | slice: 0, 1 | upcase }}</span>
                  {% if article.tags.size > 0 %}
                    <span class="longeva-journal__panel-tag">{{ article.tags.first | escape }}</span>
                  {% endif %}
                </span>
              {% endif %}
              {% if article.tags.size > 0 %}
                <span class="longeva-journal__tag">{{ article.tags.first | escape }}</span>
              {% endif %}
              <h3 class="longeva-journal__title longeva-display">{{ article.title | escape }}</h3>
              {% if article.excerpt_or_content != blank %}
                <p class="longeva-journal__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
              {% endif %}
              <p class="longeva-journal__meta">
                {%- if article.metafields.custom.reviewed_by.value -%}
                  Reviewed by {{ article.metafields.custom.reviewed_by.value.name | escape }} · {{ article.published_at | date: '%-d %B %Y' }}
                {%- else -%}
                  {{ article.published_at | date: '%-d %B %Y' }}
                {%- endif -%}
              </p>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="longeva-journal__empty">Articles coming soon.</p>
    {% endif %}
  </div>
</section>

{% endif %}{% comment %}end homepage guard{% endcomment %}

{% stylesheet %}
  .longeva-journal { background: #FAFAF7; }
  .longeva-journal__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .longeva-journal__heading {
    font-size: clamp(32px, 4vw, 44px);
    margin: 0;
    color: #1A1A1A;
  }
  .longeva-journal__view-all {
    font-family: var(--longeva-font-body);
    font-size: 15px;
    color: #1A1A1A;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .longeva-journal__cards {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .longeva-journal__card {}
  .longeva-journal__card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .longeva-journal__image {
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: 2px;
    overflow: hidden;
    transition: box-shadow 0.2s var(--longeva-ease);
  }
  .longeva-journal__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .longeva-journal__image--placeholder {
    background:
      linear-gradient(135deg, rgba(45, 25, 14, 0.08) 0%, rgba(45, 25, 14, 0) 60%),
      #B99157;
    aspect-ratio: 16 / 9;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .longeva-journal__monogram {
    font-family: var(--longeva-font-display);
    font-size: clamp(64px, 8vw, 120px);
    line-height: 1;
    color: rgba(245, 241, 234, 0.90);
    letter-spacing: -0.02em;
  }
  .longeva-journal__panel-tag {
    position: absolute;
    inset-inline-start: 20px;
    inset-block-end: 16px;
    font-family: var(--longeva-font-body);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(45, 25, 14, 0.75);
  }
  .longeva-journal__card-link:hover .longeva-journal__image,
  .longeva-journal__card-link:focus-visible .longeva-journal__image {
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }
  .longeva-journal__tag {
    display: inline-block;
    margin-block-start: 16px;
    font-family: var(--longeva-font-body);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #B99157;
  }
  .longeva-journal__title {
    font-size: 22px;
    line-height: 1.25;
    margin: 12px 0 0;
    color: #1A1A1A;
  }
  .longeva-journal__excerpt {
    font-family: var(--longeva-font-body);
    font-size: 14px;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.60);
    margin: 12px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .longeva-journal__meta {
    font-family: var(--longeva-font-body);
    font-size: 12px;
    color: rgba(26, 26, 26, 0.40);
    margin: 12px 0 0;
  }
  .longeva-journal__empty {
    font-family: var(--longeva-font-body);
    color: rgba(26, 26, 26, 0.60);
    margin: 48px 0 0;
  }

  @media (max-width: 749px) {
    .longeva-journal__cards {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva journal",
  "tag": "section",
  "class": "longeva-journal-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Journal" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "All articles" },
    { "type": "text", "id": "blog", "label": "Blog handle", "default": "journal" },
    { "type": "range", "id": "limit", "label": "Articles to show", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "use_article_image", "label": "Use article image", "info": "Leave off until brand-compliant photography is uploaded for each article. Off shows a monogram brand panel.", "default": false }
  ],
  "presets": [
    { "name": "Longeva journal" }
  ]
}
{% endschema %}
