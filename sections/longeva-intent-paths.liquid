{%- comment -%}
  Longeva homepage intent paths. Citadel brief §03 step 1 + §06
  Phase 2 explicit row: "Replace hero CTA with 3-path intent selector
  (Aesthetics / Skin Health / Weight Management). Each routes to the
  correct category hub."

  Implemented as a separate section below the trust strip so the hero
  CTAs remain available for users who want to go straight to Browse
  treatments or Book. Intent cards expose category-level routes
  (Aesthetics / Skin Health / Weight Management) to give non-aesthetics
  visitors a fast path without forcing the main menu.

  Each card has a heading, body, and link. Hides itself when no
  blocks are present.
{%- endcomment -%}

{% render 'longeva-brand-fonts' %}

{%- liquid
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead
  assign blocks = section.blocks
-%}

{% if blocks.size > 0 %}
  <section class="longeva-intent-paths longeva-page longeva-page--light" aria-labelledby="longeva-intent-paths-heading">
    <div class="longeva-container longeva-intent-paths__inner">
      {% if heading != blank or subhead != blank %}
        <header class="longeva-intent-paths__head">
          {% if heading != blank %}
            <h2 id="longeva-intent-paths-heading" class="longeva-display longeva-intent-paths__heading">{{ heading | escape }}</h2>
          {% endif %}
          {% if subhead != blank %}
            <p class="longeva-intent-paths__subhead">{{ subhead | escape }}</p>
          {% endif %}
        </header>
      {% endif %}

      <ul class="longeva-intent-paths__list" role="list" data-longeva-stagger="80">
        {% for block in blocks %}
          {%- liquid
            assign card_heading = block.settings.heading
            assign card_body = block.settings.body
            assign card_url = block.settings.link | default: '#'
            assign card_kicker = block.settings.kicker
          -%}
          <li class="longeva-intent-paths__item" data-longeva-reveal {{ block.shopify_attributes }}>
            <a class="longeva-intent-paths__card" href="{{ card_url }}">
              {% if card_kicker != blank %}
                <span class="longeva-intent-paths__kicker">{{ card_kicker | escape }}</span>
              {% endif %}
              <span class="longeva-intent-paths__title">{{ card_heading | escape }}</span>
              {% if card_body != blank %}
                <span class="longeva-intent-paths__body">{{ card_body | escape }}</span>
              {% endif %}
              <span class="longeva-intent-paths__arrow" aria-hidden="true">{% render 'longeva-arrow' %}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .longeva-intent-paths {
    background: #fff;
    padding-block: clamp(48px, 6vw, 80px);
  }
  .longeva-intent-paths__head {
    margin-block-end: 28px;
    max-width: 60ch;
  }
  .longeva-intent-paths__heading {
    font-size: clamp(28px, 3vw, 36px);
    margin: 0;
    color: #1A1A1A;
  }
  .longeva-intent-paths__subhead {
    font-family: var(--longeva-font-body);
    font-size: 16px;
    line-height: 1.55;
    color: rgba(26, 26, 26, 0.7);
    margin: 12px 0 0;
  }
  .longeva-intent-paths__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .longeva-intent-paths__item { min-width: 0; }
  .longeva-intent-paths__card {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    grid-template-areas:
      "kicker arrow"
      "title arrow"
      "body arrow";
    gap: 6px 16px;
    align-items: center;
    padding: 28px 28px;
    background: #FAFAF7;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--longeva-radius-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
    min-height: 180px;
  }
  .longeva-intent-paths__card:hover,
  .longeva-intent-paths__card:focus-visible {
    border-color: #2D190E;
    transform: translateY(-2px);
    outline: none;
  }
  .longeva-intent-paths__card:focus-visible {
    outline: 2px solid var(--longeva-focus-ring);
    outline-offset: 3px;
  }
  .longeva-intent-paths__kicker {
    grid-area: kicker;
    font-family: var(--longeva-font-body);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.6);
    font-weight: 600;
  }
  .longeva-intent-paths__title {
    grid-area: title;
    font-family: var(--longeva-font-display);
    font-size: 24px;
    line-height: 1.15;
    color: #1A1A1A;
  }
  .longeva-intent-paths__body {
    grid-area: body;
    font-family: var(--longeva-font-body);
    font-size: 14px;
    line-height: 1.5;
    color: rgba(26, 26, 26, 0.7);
    max-width: 36ch;
  }
  .longeva-intent-paths__arrow {
    grid-area: arrow;
    color: #B99157;
    align-self: end;
  }

  @media (max-width: 1023px) {
    .longeva-intent-paths__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .longeva-intent-paths__list { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Longeva intent paths",
  "tag": "section",
  "class": "longeva-intent-paths-section",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Citadel brief §03 step 1 + §06 Phase 2: three intent paths above the fold so visitors immediately route to the right category. Each card has a kicker, heading, body, and link to the relevant hub page." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your path" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Three intent paths. Each leads to a clinician-led service." }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Intent path",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker (small uppercase)" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Longeva intent paths",
      "blocks": [
        { "type": "path", "settings": { "kicker": "01 · CLINICAL AESTHETICS", "heading": "Aesthetics", "body": "Anti-Wrinkle, dermal fillers, skin boosters and conservative aesthetic treatments delivered in clinic.", "link": "/pages/aesthetics-manchester" } },
        { "type": "path", "settings": { "kicker": "02 · SKIN HEALTH", "heading": "Skin Health", "body": "Pharmacist-led care for acne, rosacea, eczema and ongoing skin conditions.", "link": "/pages/skin-health-manchester" } },
        { "type": "path", "settings": { "kicker": "03 · WEIGHT MANAGEMENT", "heading": "Weight Management", "body": "Pharmacist-led consultation, BMI and clinical-criteria-based assessment, follow-up included.", "link": "/pages/weight-management-manchester" } }
      ]
    }
  ]
}
{% endschema %}
